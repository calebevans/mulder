{
  "$defs": {
    "AblationExecutionReceipt": {
      "additionalProperties": false,
      "description": "Content-bound proof that benchmark stages were replayed or skipped.",
      "properties": {
        "base_matrix_cell": {
          "minLength": 1,
          "title": "Base Matrix Cell",
          "type": "string"
        },
        "base_result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Result Sha256",
          "type": "string"
        },
        "base_run_id": {
          "minLength": 1,
          "title": "Base Run Id",
          "type": "string"
        },
        "case_operation_counts": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "candidate_filters",
                "verifier",
                "independence_gate",
                "alternative_narrative",
                "blind_reviewer"
              ]
            },
            "type": "object"
          },
          "title": "Case Operation Counts",
          "type": "object"
        },
        "disabled": {
          "items": {
            "enum": [
              "without-candidate-filters",
              "without-verifier",
              "without-independence-gate",
              "without-alternative-narrative",
              "without-blind-reviewer"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Disabled",
          "type": "array"
        },
        "executed_stages": {
          "items": {
            "enum": [
              "candidate_filters",
              "verifier",
              "independence_gate",
              "alternative_narrative",
              "blind_reviewer"
            ],
            "type": "string"
          },
          "title": "Executed Stages",
          "type": "array"
        },
        "receipt_version": {
          "const": "mulder.benchmark.ablation/v1",
          "default": "mulder.benchmark.ablation/v1",
          "title": "Receipt Version",
          "type": "string"
        },
        "skipped_stages": {
          "items": {
            "enum": [
              "candidate_filters",
              "verifier",
              "independence_gate",
              "alternative_narrative",
              "blind_reviewer"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Skipped Stages",
          "type": "array"
        },
        "workflow_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workflow Sha256",
          "type": "string"
        }
      },
      "required": [
        "base_run_id",
        "base_matrix_cell",
        "base_result_sha256",
        "workflow_sha256",
        "disabled",
        "executed_stages",
        "skipped_stages",
        "case_operation_counts"
      ],
      "title": "AblationExecutionReceipt",
      "type": "object"
    },
    "CaseRunResult": {
      "additionalProperties": false,
      "description": "Normalized output for one case in an offline benchmark run.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "cell_status": {
          "default": "completed",
          "enum": [
            "completed",
            "failed",
            "no_verdict"
          ],
          "title": "Cell Status",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ObservedClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/ObservedCoverage"
          },
          "title": "Coverage",
          "type": "array"
        },
        "failure_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/ClaimRevision"
          },
          "title": "Revisions",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "positive",
            "no_evil_within_coverage",
            "no_verdict"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "verdict"
      ],
      "title": "CaseRunResult",
      "type": "object"
    },
    "CaseWorkflowTrace": {
      "additionalProperties": false,
      "description": "Complete, ordered stage trace used only by the benchmark ablation engine.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "input_claims": {
          "items": {
            "$ref": "#/$defs/ObservedClaim"
          },
          "title": "Input Claims",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/WorkflowStageTrace"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "input_claims",
        "stages"
      ],
      "title": "CaseWorkflowTrace",
      "type": "object"
    },
    "ClaimRevision": {
      "additionalProperties": false,
      "description": "Auditable before/after assertion revision; correctness is scored externally.",
      "properties": {
        "after": {
          "$ref": "#/$defs/ObservedClaim"
        },
        "before": {
          "$ref": "#/$defs/ObservedClaim"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "iteration": {
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "revision_id": {
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "revision_id",
        "claim_id",
        "iteration",
        "stage",
        "before",
        "after",
        "reason"
      ],
      "title": "ClaimRevision",
      "type": "object"
    },
    "ObservedClaim": {
      "additionalProperties": false,
      "description": "One atomic proposition emitted by a benchmarked system.",
      "properties": {
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "object_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object Value"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "qualifiers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Qualifiers",
          "type": "object"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "verification_state": {
          "enum": [
            "verified",
            "contradicted",
            "inconclusive",
            "unsupported",
            "unverified"
          ],
          "title": "Verification State",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object_value",
        "verification_state"
      ],
      "title": "ObservedClaim",
      "type": "object"
    },
    "ObservedCoverage": {
      "additionalProperties": false,
      "description": "Observed outcome for one declared evidence domain.",
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolOutcomeStatus"
        }
      },
      "required": [
        "domain",
        "status"
      ],
      "title": "ObservedCoverage",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "description": "Measured resources for one complete benchmark run.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "runtime_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Ms"
        },
        "unattributed_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Unattributed Tokens",
          "type": "integer"
        }
      },
      "title": "ResourceUsage",
      "type": "object"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "description": "Comparable run identity for repeats, matrices, and ablations.",
      "properties": {
        "ablations": {
          "items": {
            "type": "string"
          },
          "title": "Ablations",
          "type": "array"
        },
        "matrix_cell": {
          "minLength": 1,
          "title": "Matrix Cell",
          "type": "string"
        },
        "methodology_version": {
          "minLength": 1,
          "title": "Methodology Version",
          "type": "string"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "orchestrator_version": {
          "minLength": 1,
          "title": "Orchestrator Version",
          "type": "string"
        },
        "prompt_set_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Set Sha256"
        },
        "repeat_index": {
          "default": 0,
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "toolset_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolset Sha256"
        }
      },
      "required": [
        "matrix_cell",
        "orchestrator_version",
        "methodology_version"
      ],
      "title": "RunIdentity",
      "type": "object"
    },
    "SourceAdjudication": {
      "additionalProperties": false,
      "description": "Provenance envelope retaining a historical evaluation verbatim.",
      "properties": {
        "count_mismatch_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count Mismatch Note"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SourceAdjudicationItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "reported_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Reported Counts",
          "type": "object"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "source_path",
        "source_sha256",
        "reported_counts",
        "items",
        "note"
      ],
      "title": "SourceAdjudication",
      "type": "object"
    },
    "SourceAdjudicationItem": {
      "additionalProperties": false,
      "description": "One unchanged label imported from an earlier human adjudication.",
      "properties": {
        "ground_truth": {
          "minLength": 1,
          "title": "Ground Truth",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "observed": {
          "minLength": 1,
          "title": "Observed",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "status",
        "ground_truth",
        "observed"
      ],
      "title": "SourceAdjudicationItem",
      "type": "object"
    },
    "ToolOutcomeStatus": {
      "description": "Machine-readable execution state for a forensic tool result.\n\nThe legacy MCP response ``status`` remains ``success`` or ``error`` for\nbackwards compatibility.  This enum carries the more precise state needed\nto decide what conclusions the result can support.",
      "enum": [
        "SUCCESS_NONEMPTY",
        "SUCCESS_EMPTY",
        "NOT_APPLICABLE",
        "UNAVAILABLE",
        "UNSUPPORTED_VERSION",
        "FAILED",
        "TIMED_OUT",
        "PARTIAL",
        "SAMPLED",
        "NOT_RUN"
      ],
      "title": "ToolOutcomeStatus",
      "type": "string"
    },
    "WorkflowOperation": {
      "additionalProperties": false,
      "description": "One typed, replayable benchmark workflow transformation.",
      "properties": {
        "action": {
          "enum": [
            "remove_claim",
            "set_verification_state",
            "revise_claim"
          ],
          "title": "Action",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "iteration": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iteration"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "replacement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedClaim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        },
        "verification_state": {
          "anyOf": [
            {
              "enum": [
                "verified",
                "contradicted",
                "inconclusive",
                "unsupported",
                "unverified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification State"
        }
      },
      "required": [
        "action",
        "claim_id"
      ],
      "title": "WorkflowOperation",
      "type": "object"
    },
    "WorkflowStageTrace": {
      "additionalProperties": false,
      "description": "Operations attributed to exactly one benchmark workflow component.",
      "properties": {
        "operations": {
          "items": {
            "$ref": "#/$defs/WorkflowOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "stage": {
          "enum": [
            "candidate_filters",
            "verifier",
            "independence_gate",
            "alternative_narrative",
            "blind_reviewer"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "WorkflowStageTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned, committed result object consumed by the scorer.",
  "properties": {
    "ablation_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AblationExecutionReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "benchmark_id": {
      "minLength": 1,
      "title": "Benchmark Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseRunResult"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resources": {
      "$ref": "#/$defs/ResourceUsage"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_adjudication": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAdjudication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "system_name": {
      "minLength": 1,
      "title": "System Name",
      "type": "string"
    },
    "system_version": {
      "minLength": 1,
      "title": "System Version",
      "type": "string"
    },
    "workflow_traces": {
      "items": {
        "$ref": "#/$defs/CaseWorkflowTrace"
      },
      "title": "Workflow Traces",
      "type": "array"
    }
  },
  "required": [
    "benchmark_id",
    "run_id",
    "system_name",
    "system_version",
    "cases",
    "resources"
  ],
  "title": "BenchmarkRunResult",
  "type": "object"
}
