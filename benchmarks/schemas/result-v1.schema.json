{
  "$defs": {
    "CaseRunResult": {
      "additionalProperties": false,
      "description": "Normalized output for one case in an offline benchmark run.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "cell_status": {
          "default": "completed",
          "enum": [
            "completed",
            "failed",
            "no_verdict"
          ],
          "title": "Cell Status",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ObservedClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/ObservedCoverage"
          },
          "title": "Coverage",
          "type": "array"
        },
        "failure_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "verdict": {
          "enum": [
            "positive",
            "no_evil_within_coverage",
            "no_verdict"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "verdict"
      ],
      "title": "CaseRunResult",
      "type": "object"
    },
    "ObservedClaim": {
      "additionalProperties": false,
      "description": "One atomic proposition emitted by a benchmarked system.",
      "properties": {
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "object_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object Value"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "qualifiers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Qualifiers",
          "type": "object"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "verification_state": {
          "enum": [
            "verified",
            "contradicted",
            "inconclusive",
            "unsupported",
            "unverified"
          ],
          "title": "Verification State",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object_value",
        "verification_state"
      ],
      "title": "ObservedClaim",
      "type": "object"
    },
    "ObservedCoverage": {
      "additionalProperties": false,
      "description": "Observed outcome for one declared evidence domain.",
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolOutcomeStatus"
        }
      },
      "required": [
        "domain",
        "status"
      ],
      "title": "ObservedCoverage",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "description": "Measured resources for one complete benchmark run.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "runtime_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Ms"
        },
        "unattributed_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Unattributed Tokens",
          "type": "integer"
        }
      },
      "title": "ResourceUsage",
      "type": "object"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "description": "Comparable run identity for repeats, matrices, and ablations.",
      "properties": {
        "ablations": {
          "items": {
            "type": "string"
          },
          "title": "Ablations",
          "type": "array"
        },
        "matrix_cell": {
          "minLength": 1,
          "title": "Matrix Cell",
          "type": "string"
        },
        "methodology_version": {
          "minLength": 1,
          "title": "Methodology Version",
          "type": "string"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "orchestrator_version": {
          "minLength": 1,
          "title": "Orchestrator Version",
          "type": "string"
        },
        "prompt_set_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Set Sha256"
        },
        "repeat_index": {
          "default": 0,
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "toolset_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolset Sha256"
        }
      },
      "required": [
        "matrix_cell",
        "orchestrator_version",
        "methodology_version"
      ],
      "title": "RunIdentity",
      "type": "object"
    },
    "SourceAdjudication": {
      "additionalProperties": false,
      "description": "Provenance envelope retaining a historical evaluation verbatim.",
      "properties": {
        "count_mismatch_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count Mismatch Note"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SourceAdjudicationItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "reported_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Reported Counts",
          "type": "object"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "source_path",
        "source_sha256",
        "reported_counts",
        "items",
        "note"
      ],
      "title": "SourceAdjudication",
      "type": "object"
    },
    "SourceAdjudicationItem": {
      "additionalProperties": false,
      "description": "One unchanged label imported from an earlier human adjudication.",
      "properties": {
        "ground_truth": {
          "minLength": 1,
          "title": "Ground Truth",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "observed": {
          "minLength": 1,
          "title": "Observed",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "status",
        "ground_truth",
        "observed"
      ],
      "title": "SourceAdjudicationItem",
      "type": "object"
    },
    "ToolOutcomeStatus": {
      "description": "Machine-readable execution state for a forensic tool result.\n\nThe legacy MCP response ``status`` remains ``success`` or ``error`` for\nbackwards compatibility.  This enum carries the more precise state needed\nto decide what conclusions the result can support.",
      "enum": [
        "SUCCESS_NONEMPTY",
        "SUCCESS_EMPTY",
        "NOT_APPLICABLE",
        "UNAVAILABLE",
        "UNSUPPORTED_VERSION",
        "FAILED",
        "TIMED_OUT",
        "PARTIAL",
        "SAMPLED",
        "NOT_RUN"
      ],
      "title": "ToolOutcomeStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned, committed result object consumed by the scorer.",
  "properties": {
    "benchmark_id": {
      "minLength": 1,
      "title": "Benchmark Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseRunResult"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resources": {
      "$ref": "#/$defs/ResourceUsage"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_adjudication": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAdjudication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "system_name": {
      "minLength": 1,
      "title": "System Name",
      "type": "string"
    },
    "system_version": {
      "minLength": 1,
      "title": "System Version",
      "type": "string"
    }
  },
  "required": [
    "benchmark_id",
    "run_id",
    "system_name",
    "system_version",
    "cases",
    "resources"
  ],
  "title": "BenchmarkRunResult",
  "type": "object"
}
