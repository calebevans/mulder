        <td class="text-muted" style="font-size:0.75rem;">
          {% if s.referencing_findings %}{{ s.referencing_findings | length }} finding{{ 's' if s.referencing_findings | length != 1 }}{% else %}&mdash;{% endif %}
        </td>
