var tlFilter = 'all';
function setTlFilter(f, btn) {
  tlFilter = f;
  document.querySelectorAll('#tlFilters .filter-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('#tl-list-view .tl-item').forEach(function(item) { item.style.display = (f === 'all' || item.dataset.severity === f) ? '' : 'none'; });
}
var minimapRendered = false;
function renderMinimap() {
  if (minimapRendered) return;
  var items = document.querySelectorAll('.tl-item');
  var container = document.getElementById('tlMinimap');
  if (!items.length || !container) return;
  var times = [];
  items.forEach(function(it) { var t = it.querySelector('.tl-time'); if (t) { var d = Date.parse(t.textContent.split(' \u2014 ')[0]); if (!isNaN(d)) times.push({ts:d, sev:it.dataset.severity}); }});
  if (times.length < 2) return;
  times.sort(function(a,b){return a.ts-b.ts;});
  var minT = times[0].ts, maxT = times[times.length-1].ts, span = maxT - minT || 60000;
  var sevColors = {critical:'var(--critical)',high:'var(--high)',medium:'var(--medium)',low:'var(--low)'};
  var html = '';
  times.forEach(function(t) {
    var pct = ((t.ts - minT) / span * 100);
    html += '<div class="tl-minimap-bar" style="left:'+pct.toFixed(1)+'%;width:max(3px,'+Math.max(1,100/times.length).toFixed(1)+'%);height:100%;background:'+(sevColors[t.sev]||'var(--accent)')+';"></div>';
  });
  container.innerHTML = html;
  minimapRendered = true;
}

