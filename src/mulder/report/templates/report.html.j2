var cmdItems = [], cmdSelected = 0;
function buildCmdIndex() {
  cmdItems = [];
  cmdItems.push({type:'page',label:'Dashboard',action:function(){navigate('dashboard');}});
  {% if narrative_html %}cmdItems.push({type:'page',label:'Investigation Report',action:function(){navigate('report');}});{% endif %}
  cmdItems.push({type:'page',label:'Timeline',action:function(){navigate('timeline');}});
  cmdItems.push({type:'page',label:'Findings',action:function(){navigate('findings');}});
  cmdItems.push({type:'page',label:'ATT&CK Coverage',action:function(){navigate('attack');}});
  cmdItems.push({type:'page',label:'IOCs',action:function(){navigate('iocs');}});
  cmdItems.push({type:'page',label:'Evidence Browser',action:function(){navigate('evidence');}});
  cmdItems.push({type:'page',label:'Evidence Sources',action:function(){navigate('sources');}});
  cmdItems.push({type:'page',label:'Performance',action:function(){navigate('performance');}});
  cmdItems.push({type:'page',label:'Audit Trail',action:function(){navigate('audit');}});
  Object.keys(FINDINGS_TITLES).forEach(function(fid) { cmdItems.push({type:'finding',label:FINDINGS_TITLES[fid],meta:fid,action:function(){navigateToFinding(fid);}}); });
  Object.keys(TOOL_COUNTS).forEach(function(tn) { cmdItems.push({type:'tool',label:tn,meta:TOOL_COUNTS[tn]+' calls',action:function(){navigate('performance');}}); });
  Object.keys(SOURCE_WINDOWS).forEach(function(sn) { cmdItems.push({type:'source',label:sn,meta:(SOURCES_META[sn]||{}).line_count+' lines',action:function(){navigateToEvidence(sn);}}); });
  {% for ioc in network_iocs %}cmdItems.push({type:'ioc',label:{{ ioc.value | tojson }},meta:{{ ioc.type | tojson }},action:function(){navigate('iocs');}});
  {% endfor %}{% for ioc in file_iocs %}cmdItems.push({type:'ioc',label:{{ ioc.value | tojson }},meta:{{ ioc.type | tojson }},action:function(){navigate('iocs');}});
  {% endfor %}{% for t in mitre_techniques %}cmdItems.push({type:'attack',label:{{ t.id | tojson }},meta:{{ t.finding_count }}+' findings',action:function(){navigate('attack');}});
  {% endfor %}
}
function openCmdPalette() { if(!cmdItems.length)buildCmdIndex(); document.getElementById('cmdOverlay').classList.add('open'); document.getElementById('cmdInput').value=''; cmdSelected=0; cmdSearch(); setTimeout(function(){document.getElementById('cmdInput').focus();},50); }
function closeCmdPalette() { document.getElementById('cmdOverlay').classList.remove('open'); }
function cmdSearch() {
  var q = document.getElementById('cmdInput').value.toLowerCase();
  var results = cmdItems.filter(function(item) { return !q || item.label.toLowerCase().indexOf(q) !== -1; }).slice(0, 15);
  var html = '';
  results.forEach(function(r, i) {
    var cls = 'cmd-result-item' + (i === cmdSelected ? ' selected' : '');
    html += '<div class="'+cls+'" data-idx="'+i+'" onclick="cmdExec('+i+')" onmouseenter="cmdSelected='+i+';cmdHighlight()">';
    html += '<span class="cmd-result-type t-'+r.type+'">'+r.type+'</span><span class="cmd-result-name">'+r.label+'</span>';
    if (r.meta) html += '<span class="cmd-result-meta">'+r.meta+'</span>';
    html += '</div>';
  });
  if (!results.length) html = '<div style="padding:1rem;text-align:center;color:var(--text-dim);font-size:0.85rem;">No results</div>';
  document.getElementById('cmdResults').innerHTML = html;
  window._cmdFiltered = results;
}
function cmdHighlight() { document.querySelectorAll('.cmd-result-item').forEach(function(el,i){el.classList.toggle('selected',i===cmdSelected);}); }
function cmdExec(idx) { var r=window._cmdFiltered||[]; if(r[idx]){r[idx].action();closeCmdPalette();} }
function cmdKeydown(e) { var r=window._cmdFiltered||[]; if(e.key==='ArrowDown'){e.preventDefault();cmdSelected=Math.min(cmdSelected+1,r.length-1);cmdHighlight();}else if(e.key==='ArrowUp'){e.preventDefault();cmdSelected=Math.max(cmdSelected-1,0);cmdHighlight();}else if(e.key==='Enter'){e.preventDefault();cmdExec(cmdSelected);}else if(e.key==='Escape'){closeCmdPalette();} }

/* ========== DONUT ========== */
var donutRendered = false;
function renderDonut() {
  if (donutRendered) return;
  var counts = TOOL_COUNTS, entries = Object.keys(counts).map(function(k){return{name:k,count:counts[k]};});
  entries.sort(function(a,b){return b.count-a.count;});
  var topN = entries.slice(0,8), otherCount = entries.slice(8).reduce(function(s,e){return s+e.count;},0);
  if (otherCount > 0) topN.push({name:'Other',count:otherCount});
  var total = topN.reduce(function(s,e){return s+e.count;},0);
  if (!total) return;
  var colors = ['#5b9ef5','#7c8cf0','#3ec97a','#ee8c3a','#d9b840','#f06060','#e570a0','#2eb8a8','#8b6ef0'];
  var svg = document.getElementById('donutChart');
  var cx=80,cy=80,r=60,inner=38, svgHtml='', angle=-Math.PI/2;
  topN.forEach(function(item,i) {
    var slice=(item.count/total)*Math.PI*2;
    var x1=cx+r*Math.cos(angle),y1=cy+r*Math.sin(angle),x1i=cx+inner*Math.cos(angle),y1i=cy+inner*Math.sin(angle);
    angle+=slice;
    var x2=cx+r*Math.cos(angle),y2=cy+r*Math.sin(angle),x2i=cx+inner*Math.cos(angle),y2i=cy+inner*Math.sin(angle);
    var large=slice>Math.PI?1:0, c=colors[i%colors.length];
    svgHtml+='<path d="M'+x1+','+y1+' A'+r+','+r+' 0 '+large+',1 '+x2+','+y2+' L'+x2i+','+y2i+' A'+inner+','+inner+' 0 '+large+',0 '+x1i+','+y1i+' Z" fill="'+c+'" opacity="0.85" stroke="var(--bg)" stroke-width="2"><title>'+item.name+': '+item.count+'</title></path>';
  });
  svgHtml+='<text x="'+cx+'" y="'+(cy-4)+'" text-anchor="middle" fill="var(--text)" font-size="18" font-weight="800" font-family="var(--font)">'+total+'</text>';
  svgHtml+='<text x="'+cx+'" y="'+(cy+12)+'" text-anchor="middle" fill="var(--text-dim)" font-size="9" font-family="var(--font)">calls</text>';
  svg.innerHTML = svgHtml;
  var legend=document.getElementById('donutLegend'), legendHtml='';
  topN.forEach(function(item,i){var c=colors[i%colors.length]; legendHtml+='<div class="donut-legend-item"><div class="donut-legend-swatch" style="background:'+c+';"></div><span>'+item.name+'</span><span class="donut-legend-count">'+item.count+'</span></div>';});
  legend.innerHTML=legendHtml;
  donutRendered=true;
}

/* ========== SPARKLINE ========== */
var sparkRendered = false;
function renderSparkline() {
  if (sparkRendered || !AUDIT_DATA.length) return;
  var timestamps = AUDIT_DATA.filter(function(e){return e.timestamp;}).map(function(e){return new Date(e.timestamp).getTime();});
  if (!timestamps.length) return;
  timestamps.sort(function(a,b){return a-b;});
  var minT=timestamps[0],maxT=timestamps[timestamps.length-1],span=maxT-minT||60000;
  var buckets=60, counts=new Array(buckets).fill(0);
  timestamps.forEach(function(t){var idx=Math.min(Math.floor((t-minT)/span*buckets),buckets-1);counts[idx]++;});
  var maxCount=Math.max.apply(null,counts)||1;
  var W=800,H=80,padB=20,svgHtml='',points=[];
  counts.forEach(function(c,i){var x=(i/(buckets-1))*W,y=(H-padB)-(c/maxCount)*(H-padB-5);points.push(x+','+y);});
  svgHtml+='<defs><linearGradient id="sparkGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"/><stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>';
  svgHtml+='<polygon points="0,'+(H-padB)+' '+points.join(' ')+' '+W+','+(H-padB)+'" fill="url(#sparkGrad)"/>';
  svgHtml+='<polyline points="'+points.join(' ')+'" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"/>';
  var startLabel=new Date(minT).toISOString().substring(11,16), endLabel=new Date(maxT).toISOString().substring(11,16);
  svgHtml+='<text x="0" y="'+H+'" fill="var(--text-dim)" font-size="10" font-family="var(--mono)">'+startLabel+'</text>';
  svgHtml+='<text x="'+W+'" y="'+H+'" fill="var(--text-dim)" font-size="10" font-family="var(--mono)" text-anchor="end">'+endLabel+'</text>';
  document.getElementById('sparklineContainer').innerHTML='<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="none" style="width:100%;height:80px;">'+svgHtml+'</svg>';
  sparkRendered=true;
}

/* ========== THROUGHPUT CHART ========== */
var throughputRendered = false;
function renderThroughputChart() {
  if (throughputRendered || !AUDIT_DATA.length) return;
  var canvas = document.getElementById('throughputChart');
  var tooltip = document.getElementById('throughputTooltip');
  if (!canvas) return;
  var timestamps = AUDIT_DATA.filter(function(e){return e.timestamp;}).map(function(e){return new Date(e.timestamp).getTime();});
  if (timestamps.length < 2) return;
  timestamps.sort(function(a,b){return a-b;});
  var minT=timestamps[0], maxT=timestamps[timestamps.length-1], span=maxT-minT||60000;
  var bucketMs=300000;
  var numBuckets=Math.max(1,Math.ceil(span/bucketMs));
  if(numBuckets>200){bucketMs=span/100;numBuckets=100;}
  var counts=new Array(numBuckets).fill(0);
  timestamps.forEach(function(t){var idx=Math.min(Math.floor((t-minT)/bucketMs),numBuckets-1);counts[idx]++;});

  /* Per-model token data */
  var models=[
    {% for entry in model_token_breakdown %}
    {name:'{{ entry.model }}',total:{{ entry.input + entry.output }}},
    {% endfor %}
  ];
  var totalTok=0;
  models.forEach(function(m){totalTok+=m.total;});
  var modelColors=['#4a9eff','#f59e0b','#10b981','#ef4444','#8b5cf6'];
  var tokPerCall=timestamps.length>0?totalTok/timestamps.length:0;

  /* Build stacked data: each bucket gets proportional model splits */
  var modelFractions=models.map(function(m){return totalTok>0?m.total/totalTok:0;});
  var stackedBuckets=counts.map(function(c){
    var total=Math.round(c*tokPerCall);
    return models.map(function(m,mi){return Math.round(total*modelFractions[mi]);});
  });
  var maxTok=Math.max.apply(null,counts.map(function(c){return Math.round(c*tokPerCall);}))||1;

  var dpr=window.devicePixelRatio||1;
  var rect=canvas.getBoundingClientRect();
  canvas.width=rect.width*dpr;
  canvas.height=220*dpr;
  var ctx=canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  var W=rect.width,H=220,padL=55,padR=10,padT=10,padB=45;
  var chartW=W-padL-padR,chartH=H-padT-padB;
  var barW=Math.max(2,chartW/numBuckets-1);
  var cs=getComputedStyle(document.documentElement);
  var dimColor=cs.getPropertyValue('--text-dim').trim()||'#666';
  var borderColor=cs.getPropertyValue('--border').trim()||'#333';

  /* Y axis */
  ctx.fillStyle=dimColor;ctx.font='10px monospace';ctx.textAlign='right';
  for(var i=0;i<=4;i++){
    var yVal=Math.round(maxTok*i/4);
    var y=padT+chartH-chartH*(i/4);
    var label=yVal>=1000000?(yVal/1000000).toFixed(1)+'M':yVal>=1000?(yVal/1000).toFixed(0)+'K':yVal;
    ctx.fillText(label,padL-6,y+3);
    ctx.strokeStyle=borderColor;ctx.lineWidth=0.5;
    ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(W-padR,y);ctx.stroke();
  }

  /* Stacked bars */
  var barRects=[];
  stackedBuckets.forEach(function(stack,i){
    var x=padL+i*(chartW/numBuckets);
    var totalInBucket=0;stack.forEach(function(v){totalInBucket+=v;});
    var yOffset=0;
    var rects=[];
    stack.forEach(function(val,mi){
      var barH=(val/maxTok)*chartH;
      ctx.fillStyle=modelColors[mi%modelColors.length];
      ctx.globalAlpha=0.8;
      ctx.fillRect(x,padT+chartH-yOffset-barH,barW,barH);
      rects.push({x:x,y:padT+chartH-yOffset-barH,w:barW,h:barH,model:models[mi].name,tokens:val});
      yOffset+=barH;
    });
    ctx.globalAlpha=1;
    barRects.push({x:x,w:barW,total:totalInBucket,time:new Date(minT+i*bucketMs),segments:rects});
  });

  /* X axis labels */
  ctx.fillStyle=dimColor;ctx.font='10px monospace';ctx.textAlign='center';
  var labelCount=Math.min(8,numBuckets);
  for(var i=0;i<labelCount;i++){
    var idx=Math.round(i*(numBuckets-1)/(labelCount-1));
    var t=new Date(minT+idx*bucketMs);
    var lbl=t.toISOString().substring(11,16);
    var x=padL+idx*(chartW/numBuckets)+barW/2;
    ctx.fillText(lbl,x,H-padB+15);
  }

  /* Legend */
  var legendY=H-12;
  var legendX=padL;
  ctx.font='10px sans-serif';ctx.textAlign='left';
  models.forEach(function(m,mi){
    ctx.fillStyle=modelColors[mi%modelColors.length];
    ctx.fillRect(legendX,legendY-8,10,10);
    ctx.fillStyle=dimColor;
    var shortName=m.name.replace('claude-','');
    ctx.fillText(shortName,legendX+14,legendY);
    legendX+=ctx.measureText(shortName).width+28;
  });

  /* Tooltip on hover */
  canvas.addEventListener('mousemove',function(e){
    var cr=canvas.getBoundingClientRect();
    var mx=e.clientX-cr.left,my=e.clientY-cr.top;
    var hit=null;
    for(var i=0;i<barRects.length;i++){
      var br=barRects[i];
      if(mx>=br.x&&mx<=br.x+br.w){hit=br;break;}
    }
    if(hit&&tooltip){
      var lines='<strong>'+hit.time.toISOString().substring(11,16)+'</strong><br>';
      hit.segments.forEach(function(s,si){
        if(s.tokens>0){
          var tok=s.tokens>=1000?(s.tokens/1000).toFixed(1)+'K':s.tokens;
          lines+='<span style="color:'+modelColors[si%modelColors.length]+'">'+s.model.replace('claude-','')+'</span>: '+tok+'<br>';
        }
      });
      var totalLabel=hit.total>=1000?(hit.total/1000).toFixed(1)+'K':hit.total;
      lines+='Total: '+totalLabel;
      tooltip.innerHTML=lines;
      tooltip.style.display='block';
      tooltip.style.left=Math.min(e.clientX-cr.left+10,W-140)+'px';
      tooltip.style.top=(e.clientY-cr.top-60)+'px';
    } else if(tooltip){tooltip.style.display='none';}
  });
  canvas.addEventListener('mouseleave',function(){if(tooltip)tooltip.style.display='none';});

  throughputRendered=true;
}

var perfObserver=new MutationObserver(function(){
  var perfPage=document.getElementById('page-performance');
  if(perfPage&&perfPage.classList.contains('active')){renderThroughputChart();}
});
perfObserver.observe(document.body,{subtree:true,attributes:true,attributeFilter:['class']});

/* ========== BACK TO TOP ========== */
window.addEventListener('scroll', function() {
  document.getElementById('backToTop').classList.toggle('visible', window.scrollY > 400);
});

/* ========== KEYBOARD SHORTCUTS ========== */
document.addEventListener('keydown', function(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openCmdPalette(); return; }
  if (e.key === 'Escape') { closeCmdPalette(); closeDrawer(); }
  if (e.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) { e.preventDefault(); var ap=document.querySelector('.page.active'), s=ap?ap.querySelector('.search-input'):null; if(s)s.focus(); }
  var findingsActive = document.getElementById('page-findings') && document.getElementById('page-findings').classList.contains('active');
  if (findingsActive && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) {
    if (e.key === 'j') { e.preventDefault(); kbdMoveFinding(1); }
    else if (e.key === 'k') { e.preventDefault(); kbdMoveFinding(-1); }
    else if (e.key === 'Enter' && kbdFocusIdx >= 0) { e.preventDefault(); var c = getVisibleFindings()[kbdFocusIdx]; if(c) c.classList.toggle('open'); }
  }
});

/* ===================== MERMAID RENDERING ===================== */
(function() {
  var codeBlocks = document.querySelectorAll('pre code');
  var hasMermaid = false;
  codeBlocks.forEach(function(block) {
    var text = block.textContent.trim();
    var isMermaid = block.classList.contains('language-mermaid') ||
      text.match(/^(graph |flowchart |sequenceDiagram|classDiagram|stateDiagram|gantt|pie |erDiagram|journey)/);
    if (isMermaid) {
      hasMermaid = true;
      /* Decode HTML entities that the markdown renderer escaped */
      var tmp = document.createElement('textarea');
      tmp.innerHTML = text;
      var decoded = tmp.value;
      var container = document.createElement('div');
      container.className = 'mermaid';
      container.textContent = decoded;
      var pre = block.parentElement;
      pre.parentElement.replaceChild(container, pre);
    }
  });
  if (hasMermaid) {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    s.onload = function() {
      mermaid.initialize({ startOnLoad: false, theme: 'dark', themeVariables: { primaryColor: '#2a6dd4', primaryTextColor: '#e0e0e0', lineColor: '#555', fontSize: '13px' }});
      mermaid.run({ querySelector: '.mermaid' });
    };
    document.body.appendChild(s);
  }
})();
</script>
