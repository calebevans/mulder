function setFindingFilter(filter, btn) { currentFindingFilter = filter; document.querySelectorAll('#findingFilters .filter-btn').forEach(function(b) { b.classList.remove('active'); }); btn.classList.add('active'); filterFindings(); }
function filterFindings() {
