<!-- Command Palette -->
<div class="cmd-overlay" id="cmdOverlay" onclick="if(event.target===this)closeCmdPalette()">
  <div class="cmd-palette">
    <div class="cmd-input-wrap">
      <span class="cmd-input-icon">&#8984;</span>
      <input type="text" class="cmd-input" id="cmdInput" placeholder="Search findings, tools, IOCs, pages..." oninput="cmdSearch()" onkeydown="cmdKeydown(event)">
    </div>
    <div class="cmd-results" id="cmdResults"></div>
    <div class="cmd-footer">
      <span><kbd>&#8593;&#8595;</kbd> navigate</span>
      <span><kbd>&#8629;</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

<div class="copy-toast" id="copyToast">Copied to clipboard</div>
<button class="back-to-top" id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Back to top">&#8593;</button>

<script>
/* ========== DATA ========== */
var AUDIT_DATA = {{ audit_entries | tojson }};
var TOOL_COUNTS = {{ tool_call_counts | tojson }};
var FINDINGS_TITLES = { {% for f in findings %}"{{ f.finding_id }}": {{ f.title | tojson }}{% if not loop.last %},{% endif %}{% endfor %} };
var SOURCE_WINDOWS = {{ source_windows | tojson }};
var SOURCES_META = { {% for s in sources_list %}"{{ s.source_name }}": {"extractor":"{{ s.extractor }}","line_count":{{ s.line_count }},"hash":"{{ s.source_hash[:16] }}"}{% if not loop.last %},{% endif %}{% endfor %} };

var AUDIT_INDEX = {};
AUDIT_DATA.forEach(function(e) { AUDIT_INDEX[e.tool_call_id] = e; });
var FINDING_REFS = {};
{% for f in findings %}FINDING_REFS["{{ f.finding_id }}"] = {{ f.evidence_refs | tojson }};
{% endfor %}
var TC_TO_FINDINGS = {};
Object.keys(FINDING_REFS).forEach(function(fid) {
  FINDING_REFS[fid].forEach(function(tc) {
    if (!TC_TO_FINDINGS[tc]) TC_TO_FINDINGS[tc] = [];
    TC_TO_FINDINGS[tc].push(fid);
  });
});

/* ========== THEME ========== */
function toggleTheme() {
  var html = document.documentElement;
  var cur = html.getAttribute('data-theme');
  var next = cur === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('mulder-theme', next);
  updateThemeIcon();
  donutRendered = false; sparkRendered = false;
}
function updateThemeIcon() {
  var btn = document.getElementById('themeBtn');
