</div>

<!-- ==================== EVIDENCE SOURCES ==================== -->
<div class="page" id="page-sources">
  <div class="page-header">
    <h2>Evidence Sources</h2>
    <div class="subtitle">{{ sources_list | length }} ingested sources from {{ evidence_root }}</div>
  </div>
  {% if sources_list %}
  <div class="search-wrap">
    <input type="text" class="search-input" id="sourceSearch" placeholder="Search sources..." oninput="filterSourceTable()">
  </div>
  <table class="data-table" id="sourceTable">
    <thead>
      <tr>
        <th onclick="sortTable('sourceTable',0)">Source Name <span class="sort-arrow"></span></th>
        <th onclick="sortTable('sourceTable',1)">Extractor <span class="sort-arrow"></span></th>
        <th onclick="sortTable('sourceTable',2)">Lines <span class="sort-arrow"></span></th>
        <th onclick="sortTable('sourceTable',3)">Hash <span class="sort-arrow"></span></th>
        <th onclick="sortTable('sourceTable',4)">Referenced By <span class="sort-arrow"></span></th>
      </tr>
    </thead>
    <tbody>
    {% for s in sources_list %}
      <tr style="cursor:pointer" onclick="navigateToEvidence('{{ s.source_name }}')">
        <td><strong>{{ s.source_name }}</strong></td>
