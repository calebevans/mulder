<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mulder Report: {{ case_id }}</title>
<script>
(function(){var t=localStorage.getItem('mulder-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t)}else if(window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches){document.documentElement.setAttribute('data-theme','light')}})();
</script>
<style>
/* ===================== DARK THEME (default) ===================== */
:root, [data-theme="dark"] {
  --bg: #12161f;
  --bg2: #171c28;
  --surface: rgba(28,34,48,0.88);
  --surface-solid: #1c2230;
  --surface2: #232a3a;
  --surface3: #2a3346;
  --border: #303a50;
  --border-light: #3e4a62;
  --text: #e8ecf4;
  --text-muted: #97a3bc;
  --text-dim: #6b7a96;
  --accent: #5b9ef5;
  --accent2: #7c8cf0;
  --accent-dim: rgba(91,158,245,0.13);
  --accent-glow: rgba(91,158,245,0.22);
  --critical: #f06060;
  --critical-dim: rgba(240,96,96,0.13);
  --critical-border: rgba(239,68,68,0.25);
  --high: #ee8c3a;
  --high-dim: rgba(238,140,58,0.13);
  --high-border: rgba(249,115,22,0.25);
  --medium: #d9b840;
  --medium-dim: rgba(217,184,64,0.13);
  --medium-border: rgba(234,179,8,0.25);
  --low: #3ec97a;
  --low-dim: rgba(62,201,122,0.13);
  --low-border: rgba(34,197,94,0.25);
  --info: #717bf0;
  --info-dim: rgba(113,123,240,0.13);
  --info-border: rgba(99,102,241,0.25);
  --confirmed: #3ec97a;
  --inference: #d9b840;
  --overlay: rgba(0,0,0,0.6);
  --overlay-light: rgba(0,0,0,0.5);
  --code-bg: #12161f;
  --hover-tint: rgba(96,165,250,0.04);
  --font: 'Inter', 'SF Pro Display', 'Segoe UI', system-ui, -apple-system, sans-serif;
  --mono: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', monospace;
  --radius: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --shadow: 0 2px 8px rgba(0,0,0,0.22);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.3);
  --shadow-glow: 0 0 20px rgba(91,158,245,0.12);
  --transition: 0.2s ease;
  --transition-slow: 0.4s cubic-bezier(0.4,0,0.2,1);
}

/* ===================== LIGHT THEME ===================== */
[data-theme="light"] {
  --bg: #f5f6fa;
  --bg2: #ffffff;
  --surface: rgba(255,255,255,0.92);
  --surface-solid: #ffffff;
  --surface2: #eef0f5;
  --surface3: #e2e5ed;
  --border: #d5d9e2;
  --border-light: #c0c6d2;
  --text: #1a1d26;
  --text-muted: #5a6478;
  --text-dim: #8892a6;
  --accent: #3b7de0;
  --accent2: #5c6cd6;
  --accent-dim: rgba(59,125,224,0.1);
  --accent-glow: rgba(59,125,224,0.18);
  --critical: #dc3545;
  --critical-dim: rgba(220,53,69,0.1);
  --critical-border: rgba(220,53,69,0.3);
  --high: #d97a1e;
  --high-dim: rgba(217,122,30,0.1);
  --high-border: rgba(217,122,30,0.3);
  --medium: #b89a10;
  --medium-dim: rgba(184,154,16,0.1);
  --medium-border: rgba(184,154,16,0.3);
  --low: #28a05a;
  --low-dim: rgba(40,160,90,0.1);
  --low-border: rgba(40,160,90,0.3);
  --info: #5560c0;
  --info-dim: rgba(85,96,192,0.1);
  --info-border: rgba(85,96,192,0.3);
  --confirmed: #28a05a;
  --inference: #b89a10;
  --overlay: rgba(0,0,0,0.35);
  --overlay-light: rgba(0,0,0,0.25);
  --code-bg: #f0f2f7;
  --hover-tint: rgba(59,125,224,0.04);
  --shadow: 0 2px 8px rgba(0,0,0,0.08);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
  --shadow-glow: 0 0 20px rgba(59,125,224,0.08);
}

/* ===================== RESET & BASE ===================== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { background: var(--bg); color: var(--text); font-family: var(--font); line-height: 1.65; font-size: 14px; overflow-x: hidden; }
.app { display: flex; min-height: 100vh; }

/* ===================== SIDEBAR ===================== */
.sidebar {
  width: 260px; background: var(--bg2); border-right: 1px solid var(--border);
  display: flex; flex-direction: column; position: fixed;
  top: 0; left: 0; bottom: 0; z-index: 100; transition: transform var(--transition-slow);
}
.sidebar-brand {
  padding: 1.5rem 1.5rem 1.25rem; border-bottom: 1px solid var(--border);
  background: linear-gradient(135deg, var(--accent-dim) 0%, transparent 60%);
}
.sidebar-brand h1 { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; }
.sidebar-brand h1 span { background: linear-gradient(135deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.sidebar-brand .case-id { font-size: 0.72rem; color: var(--text-muted); font-family: var(--mono); margin-top: 0.3rem; }
.sidebar-nav { flex: 1; padding: 0.75rem 0; overflow-y: auto; }
.nav-section-label { font-size: 0.62rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; padding: 1rem 1.5rem 0.4rem; font-weight: 600; }
.nav-item {
  display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 1.5rem;
  color: var(--text-muted); text-decoration: none; font-size: 0.82rem; font-weight: 500;
  cursor: pointer; transition: all var(--transition); border-left: 3px solid transparent; position: relative;
}
.nav-item:hover { color: var(--text); background: var(--hover-tint); }
.nav-item.active { color: var(--accent); background: linear-gradient(90deg, var(--accent-dim), transparent); border-left-color: var(--accent); }
.nav-icon { font-size: 1rem; width: 1.4rem; text-align: center; flex-shrink: 0; opacity: 0.7; }
.nav-item.active .nav-icon { opacity: 1; }
.nav-badge { margin-left: auto; background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 0.1em 0.5em; font-size: 0.62rem; font-weight: 600; color: var(--text-dim); font-family: var(--mono); }
.sidebar-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--border); font-size: 0.68rem; color: var(--text-dim); }
.sidebar-footer a { color: var(--accent); text-decoration: none; }
.sidebar-footer .shortcut-hint { margin-top: 0.5rem; padding: 0.3rem 0.5rem; background: var(--surface2); border-radius: 6px; display: inline-block; font-family: var(--mono); font-size: 0.65rem; }
.theme-toggle { background: var(--surface2); border: 1px solid var(--border); color: var(--text-muted); width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: all 0.15s; margin-top: 0.5rem; }
.theme-toggle:hover { border-color: var(--accent); color: var(--accent); }

/* ===================== MAIN ===================== */
.main { margin-left: 260px; flex: 1; min-width: 0; }
.page { display: none; padding: 2rem 2.5rem 3rem; max-width: 1200px; margin: 0 auto; opacity: 0; transform: translateY(8px); }
.page.active { display: block; animation: pageIn 0.35s cubic-bezier(0.4,0,0.2,1) forwards; }
@keyframes pageIn { to { opacity: 1; transform: translateY(0); } }

/* ===================== MOBILE ===================== */
.mobile-toggle { display: none; position: fixed; top: 0.75rem; left: 0.75rem; z-index: 200; background: var(--surface-solid); border: 1px solid var(--border); color: var(--text); width: 40px; height: 40px; border-radius: var(--radius); cursor: pointer; font-size: 1.1rem; backdrop-filter: blur(12px); }
.sidebar-overlay { display: none; position: fixed; inset: 0; background: var(--overlay); z-index: 90; backdrop-filter: blur(4px); }
@media (max-width: 860px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-overlay.open { display: block; }
  .mobile-toggle { display: flex; align-items: center; justify-content: center; }
  .main { margin-left: 0; }
  .page { padding: 3.5rem 1rem 2rem; }
  .ev-browser { flex-direction: column; }
  .ev-source-tree { width: 100%; max-height: 200px; border-right: none; border-bottom: 1px solid var(--border); }
}

/* ===================== SHARED COMPONENTS ===================== */
.page-header { margin-bottom: 2rem; }
.page-header h2 { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(135deg, var(--text), var(--text-muted)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.page-header .subtitle { color: var(--text-muted); font-size: 0.82rem; margin-top: 0.3rem; }
.card { background: var(--surface); backdrop-filter: blur(16px); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--transition), box-shadow var(--transition); }
.card:hover { border-color: var(--border-light); }
.card-header { padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border); font-weight: 600; font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.5rem; }
.card-body { padding: 1.25rem; }

.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
.stat { background: var(--surface); backdrop-filter: blur(12px); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.15rem 1.25rem; transition: all var(--transition); position: relative; overflow: hidden; }
.stat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0; transition: opacity var(--transition); }
.stat:hover { border-color: var(--border-light); transform: translateY(-1px); box-shadow: var(--shadow); }
.stat:hover::before { opacity: 1; }
.stat-value { font-size: 1.85rem; font-weight: 800; color: var(--accent); line-height: 1.1; letter-spacing: -0.02em; }
.stat-label { font-size: 0.68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 0.3rem; font-weight: 500; }
.stat.critical .stat-value { color: var(--critical); }
.stat.critical::before { background: linear-gradient(90deg, transparent, var(--critical), transparent); }
.stat.high .stat-value { color: var(--high); }
.stat.high::before { background: linear-gradient(90deg, transparent, var(--high), transparent); }
.stat.medium .stat-value { color: var(--medium); }
.stat.low .stat-value { color: var(--low); }

.badge { display: inline-flex; align-items: center; padding: 0.2em 0.6em; border-radius: 6px; font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
.badge-critical { background: var(--critical-dim); color: var(--critical); border: 1px solid var(--critical-border); }
.badge-high { background: var(--high-dim); color: var(--high); border: 1px solid var(--high-border); }
.badge-medium { background: var(--medium-dim); color: var(--medium); border: 1px solid var(--medium-border); }
.badge-low { background: var(--low-dim); color: var(--low); border: 1px solid var(--low-border); }
.badge-info { background: var(--info-dim); color: var(--info); border: 1px solid var(--info-border); }
.badge-confirmed { background: var(--low-dim); color: var(--confirmed); border: 1px solid var(--low-border); }
.badge-inference { background: var(--medium-dim); color: var(--inference); border: 1px solid var(--medium-border); }

.search-input { width: 100%; padding: 0.6rem 1rem 0.6rem 2.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-family: var(--font); font-size: 0.85rem; outline: none; transition: all var(--transition); }
.search-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }
.search-input::placeholder { color: var(--text-dim); }
.search-wrap { position: relative; margin-bottom: 1rem; }
.search-wrap::before { content: '\2315'; position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-dim); font-size: 1.1rem; pointer-events: none; }

.filter-bar { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
.filter-btn { background: var(--surface); border: 1px solid var(--border); color: var(--text-muted); padding: 0.35em 0.85em; border-radius: 8px; font-size: 0.72rem; font-weight: 500; cursor: pointer; transition: all 0.15s; font-family: var(--font); }
.filter-btn:hover { border-color: var(--accent); color: var(--text); }
.filter-btn.active { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border-color: transparent; font-weight: 600; }

table.data-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
table.data-table th { text-align: left; padding: 0.65rem 0.85rem; background: var(--surface2); border-bottom: 2px solid var(--border); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); cursor: pointer; user-select: none; white-space: nowrap; }
table.data-table th:hover { color: var(--accent); }
table.data-table th .sort-arrow { margin-left: 0.3em; font-size: 0.6rem; }
table.data-table td { padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--border); vertical-align: top; }
table.data-table tr { transition: background var(--transition); }
table.data-table tr:hover td { background: var(--hover-tint); }
table.data-table code { font-family: var(--mono); font-size: 0.78em; color: var(--accent); word-break: break-all; }

.tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 1.25rem; }
.tab-btn { padding: 0.6rem 1.15rem; font-size: 0.78rem; font-weight: 500; color: var(--text-muted); background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: all var(--transition); font-family: var(--font); }
.tab-btn:hover { color: var(--text); }
.tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
.tab-pane { display: none; }
.tab-pane.active { display: block; }

.mono { font-family: var(--mono); font-size: 0.82em; }
.text-muted { color: var(--text-muted); }
.text-dim { color: var(--text-dim); }
.text-accent { color: var(--accent); }
.mt-1 { margin-top: 0.75rem; }
.mt-2 { margin-top: 1.5rem; }
.mb-1 { margin-bottom: 0.75rem; }
.mb-2 { margin-bottom: 1.5rem; }
.gap-row { display: flex; gap: 1rem; flex-wrap: wrap; }

.stagger-in > * { opacity: 0; transform: translateY(12px); animation: staggerItem 0.4s cubic-bezier(0.4,0,0.2,1) forwards; }
.stagger-in > *:nth-child(1) { animation-delay: 0.05s; }
.stagger-in > *:nth-child(2) { animation-delay: 0.1s; }
.stagger-in > *:nth-child(3) { animation-delay: 0.15s; }
.stagger-in > *:nth-child(4) { animation-delay: 0.2s; }
.stagger-in > *:nth-child(5) { animation-delay: 0.25s; }
.stagger-in > *:nth-child(6) { animation-delay: 0.3s; }
.stagger-in > *:nth-child(7) { animation-delay: 0.35s; }
.stagger-in > *:nth-child(8) { animation-delay: 0.4s; }
@keyframes staggerItem { to { opacity: 1; transform: translateY(0); } }

/* ===================== EXECUTIVE SUMMARY ===================== */
.exec-summary { background: linear-gradient(135deg, var(--accent-dim), rgba(129,140,248,0.05)); border: 1px solid var(--accent-glow); border-radius: var(--radius-lg); padding: 1.5rem 1.75rem; margin-bottom: 1.75rem; position: relative; overflow: hidden; }
.exec-summary::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent)); }
.exec-summary-label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); font-weight: 600; margin-bottom: 0.6rem; }
.exec-summary p { font-size: 0.92rem; line-height: 1.7; color: var(--text-muted); margin: 0 0 0.75rem 0; }
.exec-summary p:last-child { margin-bottom: 0; }
.exec-summary strong { color: var(--text); }
.exec-summary em { color: var(--accent); font-style: normal; }
.exec-meta { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--border); }
.exec-pill { display: inline-flex; align-items: center; gap: 0.35em; font-size: 0.78rem; padding: 0.3em 0.7em; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); color: var(--text-muted); white-space: nowrap; line-height: 1.4; }
.exec-pill .ep-icon { font-size: 0.85em; flex-shrink: 0; }
.exec-pill .ep-val { font-weight: 600; color: var(--text); }
.exec-threats { margin-top: 0.5rem; }
.exec-threats strong { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); margin-bottom: 0.4rem; }
.exec-threats ul { margin: 0; padding-left: 1.2rem; }
.exec-threats li { font-size: 0.88rem; line-height: 1.6; color: var(--text-muted); }

/* ===================== NARRATIVE REPORT ===================== */
.report-narrative { max-width: 800px; line-height: 1.85; color: var(--text-muted); font-size: 0.92rem; }
.report-narrative h1, .report-narrative h2, .report-narrative h3, .report-narrative h4 { color: var(--text); margin-top: 1.8rem; margin-bottom: 0.6rem; line-height: 1.3; }
.report-narrative h3 { font-size: 1.15rem; font-weight: 700; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
.report-narrative h4 { font-size: 0.98rem; font-weight: 600; }
.report-narrative p { margin: 0 0 1rem 0; }
.report-narrative ul, .report-narrative ol { margin: 0 0 1rem 0; padding-left: 1.4rem; }
.report-narrative li { margin-bottom: 0.35rem; }
.report-narrative strong { color: var(--text); }
.report-narrative em { color: var(--accent); font-style: italic; }
.report-narrative code { background: var(--code-bg); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.85em; font-family: var(--mono); }
.report-narrative .mermaid { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; margin: 1.5rem 0; overflow-x: auto; }
.report-narrative .mermaid svg { max-width: 100%; height: auto; }
.report-narrative blockquote { border-left: 3px solid var(--accent); padding: 0.5rem 1rem; margin: 0 0 1rem 0; background: var(--accent-dim); border-radius: 0 var(--radius) var(--radius) 0; }

/* ===================== DASHBOARD ===================== */
.severity-bar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; margin-top: 0.5rem; background: var(--surface2); }
.severity-bar > div { transition: width 0.8s cubic-bezier(0.4,0,0.2,1); }
.severity-bar .seg-critical { background: linear-gradient(90deg, var(--critical), #d44); }
.severity-bar .seg-high { background: linear-gradient(90deg, var(--high), #d07020); }
.severity-bar .seg-medium { background: linear-gradient(90deg, var(--medium), #b89a20); }
.severity-bar .seg-low { background: linear-gradient(90deg, var(--low), #2aa35c); }
.severity-bar .seg-info { background: linear-gradient(90deg, var(--info), #5560d0); }
.severity-legend { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.75rem; font-size: 0.72rem; color: var(--text-muted); }
.severity-legend span { display: flex; align-items: center; gap: 0.35rem; }
.severity-legend span::before { content: ''; display: inline-block; width: 10px; height: 10px; border-radius: 3px; }
.severity-legend .leg-critical::before { background: var(--critical); }
.severity-legend .leg-high::before { background: var(--high); }
.severity-legend .leg-medium::before { background: var(--medium); }
.severity-legend .leg-low::before { background: var(--low); }
.severity-legend .leg-info::before { background: var(--info); }
.critical-list { list-style: none; }
.critical-list li { padding: 0.75rem 1rem; border-left: 3px solid var(--critical); background: var(--critical-dim); border-radius: 0 var(--radius) var(--radius) 0; margin-bottom: 0.5rem; font-size: 0.85rem; cursor: pointer; transition: all var(--transition); }
.critical-list li:hover { background: rgba(239,68,68,0.18); transform: translateX(4px); }
.critical-list .crit-time { font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem; }

.dash-widgets { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
@media (max-width: 860px) { .dash-widgets { grid-template-columns: 1fr; } }
.widget-grid { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.5rem 0; }
.widget-tech { font-size: 0.7rem; padding: 0.25em 0.5em; border-radius: 5px; font-family: var(--mono); background: var(--info-dim); color: var(--info); border: 1px solid var(--info-border); text-decoration: none; transition: all 0.15s; cursor: pointer; }
.widget-tech:hover { background: var(--info); color: #fff; }
.widget-ioc-row { display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.8rem; border-bottom: 1px solid var(--border); }
.widget-ioc-row:last-child { border-bottom: none; }

/* ===================== TIMELINE ===================== */
.tl-controls { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; }
.tl-controls .filter-bar { margin-bottom: 0; }
.tl-minimap { width: 100%; height: 32px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; margin-bottom: 1rem; overflow: hidden; position: relative; }
.tl-minimap-bar { position: absolute; bottom: 0; background: var(--accent); opacity: 0.6; border-radius: 2px 2px 0 0; min-width: 3px; transition: opacity 0.15s; }
.tl-minimap-bar:hover { opacity: 1; }
.timeline { position: relative; padding-left: 2.5rem; }
.timeline::before { content: ''; position: absolute; left: 0.85rem; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, var(--border) 0%, var(--accent) 30%, var(--accent) 70%, var(--border) 100%); }
.tl-group-label { font-size: 0.72rem; font-weight: 700; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; padding: 1rem 0 0.5rem; }
.tl-item { position: relative; margin-bottom: 0.75rem; padding: 0.85rem 1.15rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: all var(--transition); }
.tl-item:hover { border-color: var(--accent); box-shadow: var(--shadow), var(--shadow-glow); transform: translateX(4px); }
.tl-item::before { content: ''; position: absolute; left: -2.15rem; top: 1.1rem; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--border); background: var(--bg); transition: all var(--transition); }
.tl-item:hover::before { transform: scale(1.3); }
.tl-item.sev-critical::before { border-color: var(--critical); background: var(--critical); box-shadow: 0 0 8px rgba(239,68,68,0.5); }
.tl-item.sev-high::before { border-color: var(--high); background: var(--high); box-shadow: 0 0 6px rgba(249,115,22,0.3); }
.tl-item.sev-medium::before { border-color: var(--medium); background: var(--medium); }
.tl-item.sev-low::before { border-color: var(--low); background: var(--low); }
.tl-time { font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted); }
.tl-title { font-weight: 700; font-size: 0.9rem; margin-top: 0.2rem; }
.tl-badges { display: flex; gap: 0.4rem; margin-top: 0.4rem; flex-wrap: wrap; }
.tl-sources { font-size: 0.72rem; color: var(--text-dim); margin-top: 0.3rem; }
.tl-detail-panel { display: none; margin: -0.75rem 0 0.75rem; padding: 1.15rem 1.25rem; background: var(--surface2); border: 1px solid var(--border); border-top: none; border-radius: 0 0 var(--radius) var(--radius); font-size: 0.85rem; }
.tl-detail-panel.open { display: block; animation: pageIn 0.2s ease forwards; }
.tl-detail-panel p { margin-bottom: 0.5rem; }
.tl-detail-panel pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.85rem; overflow-x: auto; font-family: var(--mono); font-size: 0.78rem; line-height: 1.5; margin: 0.5rem 0; }
.tl-detail-panel code { font-family: var(--mono); font-size: 0.82em; background: var(--surface3); padding: 0.15em 0.35em; border-radius: 4px; }
.tl-detail-panel ul, .tl-detail-panel ol { margin: 0.3rem 0 0.5rem 1.5rem; }

/* ===================== FINDINGS ===================== */
.findings-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem; }
.findings-toolbar-actions { display: flex; gap: 0.5rem; }
.btn-sm { padding: 0.35em 0.8em; background: var(--surface); border: 1px solid var(--border); color: var(--text-muted); border-radius: 8px; font-size: 0.72rem; font-weight: 500; cursor: pointer; transition: all 0.15s; font-family: var(--font); }
.btn-sm:hover { border-color: var(--accent); color: var(--accent); }
.finding-card { background: var(--surface); backdrop-filter: blur(12px); border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 0.75rem; overflow: hidden; transition: all var(--transition); }
.finding-card:hover { border-color: var(--border-light); }
.finding-card.open { border-color: var(--accent); box-shadow: var(--shadow-glow); }
.finding-card.kbd-focus { box-shadow: 0 0 0 2px var(--accent), var(--shadow-glow); }
.finding-header { display: flex; align-items: center; gap: 0.6rem; padding: 0.9rem 1.25rem; cursor: pointer; user-select: none; transition: background 0.15s; }
.finding-header:hover { background: var(--hover-tint); }
.finding-chevron { font-size: 0.6rem; color: var(--text-dim); transition: transform 0.25s cubic-bezier(0.4,0,0.2,1); flex-shrink: 0; }
.finding-card.open .finding-chevron { transform: rotate(90deg); }
.finding-name { font-weight: 700; font-size: 0.88rem; flex-grow: 1; min-width: 0; }
.finding-body { display: none; border-top: 1px solid var(--border); }
.finding-card.open .finding-body { display: block; animation: pageIn 0.25s ease forwards; }
.finding-desc { padding: 1.25rem 1.5rem; }
.finding-desc p { margin-bottom: 0.6rem; line-height: 1.7; }
.finding-desc pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; overflow-x: auto; font-family: var(--mono); font-size: 0.78rem; line-height: 1.5; margin: 0.6rem 0; }
.finding-desc code { font-family: var(--mono); font-size: 0.82em; background: var(--surface3); padding: 0.15em 0.35em; border-radius: 4px; }
.finding-desc ul, .finding-desc ol { margin: 0.3rem 0 0.6rem 1.5rem; }
.evidence-strength { display: flex; align-items: center; gap: 0.5rem; padding: 0 1.25rem 0.75rem; font-size: 0.72rem; color: var(--text-dim); }
.evidence-strength-bar { flex: 1; max-width: 120px; height: 4px; background: var(--surface2); border-radius: 2px; overflow: hidden; }
.evidence-strength-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 2px; transition: width 0.6s ease; }
.finding-related { padding: 0 1.25rem 0.75rem; display: flex; gap: 0.4rem; flex-wrap: wrap; }
.finding-related-link { font-size: 0.7rem; color: var(--accent); cursor: pointer; background: var(--accent-dim); padding: 0.2em 0.5em; border-radius: 4px; text-decoration: none; transition: background 0.15s; }
.finding-related-link:hover { background: var(--accent-glow); }
.finding-source-pills { padding: 0 1.25rem 0.75rem; display: flex; gap: 0.35rem; flex-wrap: wrap; }
.source-pill { font-size: 0.68rem; color: var(--text-muted); background: var(--surface2); padding: 0.2em 0.55em; border-radius: 5px; border: 1px solid var(--border); cursor: pointer; transition: all 0.15s; }
.source-pill:hover { border-color: var(--accent); color: var(--accent); }
.attack-pill { font-size: 0.68rem; color: var(--info); background: var(--info-dim); padding: 0.2em 0.55em; border-radius: 5px; border: 1px solid var(--info-border); text-decoration: none; transition: all 0.15s; font-family: var(--mono); }
.attack-pill:hover { border-color: var(--info); color: #fff; background: var(--info); }
.evidence-chain { padding: 0 1.25rem 1rem; }
.evidence-chain h4 { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.6rem; }
.ev-item { display: grid; grid-template-columns: auto 1fr auto; gap: 0.6rem; padding: 0.5rem 0.75rem; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 0.35rem; font-size: 0.78rem; align-items: center; cursor: pointer; transition: all var(--transition); }
.ev-item:hover { border-color: var(--accent); background: var(--accent-dim); }
.ev-id { font-family: var(--mono); color: var(--accent); font-size: 0.7rem; }
.ev-tool { font-weight: 600; }
.ev-duration { font-family: var(--mono); color: var(--text-dim); font-size: 0.68rem; }
.finding-meta-bar { display: flex; flex-wrap: wrap; gap: 1.5rem; padding: 0.9rem 1.25rem; background: var(--bg2); border-top: 1px solid var(--border); font-size: 0.75rem; color: var(--text-muted); }
.finding-meta-bar strong { color: var(--text); }

/* ===================== PERFORMANCE ===================== */
.perf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
@media (max-width: 860px) { .perf-grid { grid-template-columns: 1fr; } }
.donut-container { display: flex; align-items: center; justify-content: center; gap: 2rem; padding: 1rem; }
.donut-legend { display: flex; flex-direction: column; gap: 0.4rem; }
.donut-legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; }
.donut-legend-swatch { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }
.donut-legend-count { font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim); margin-left: auto; padding-left: 1rem; }
.gantt-container { overflow-x: auto; padding: 0.5rem 0; }
.audit-bar-chart { margin: 1rem 0; }
.bar-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; font-size: 0.78rem; }
.bar-label { width: 200px; text-align: right; color: var(--text-muted); font-family: var(--mono); font-size: 0.72rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 0; }
.bar-track { flex: 1; height: 22px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 4px; transition: width 0.8s cubic-bezier(0.4,0,0.2,1); min-width: 3px; }
.bar-count { width: 80px; font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted); }
.sparkline-container { padding: 0.5rem 0; }
.sparkline-container svg { display: block; width: 100%; }

/* ===================== AUDIT ===================== */
.provenance-section { margin-top: 1.5rem; }
.prov-finding { margin-bottom: 0.75rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: border-color var(--transition); }
.prov-finding:hover { border-color: var(--border-light); }
.prov-header { padding: 0.7rem 1rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; transition: background var(--transition); }
.prov-header:hover { background: var(--surface2); }
.prov-header .prov-chevron { font-size: 0.55rem; color: var(--text-dim); transition: transform 0.25s; }
.prov-finding.open .prov-chevron { transform: rotate(90deg); }
.prov-body { display: none; border-top: 1px solid var(--border); padding: 0.85rem 1rem; }
.prov-finding.open .prov-body { display: block; }
.prov-step { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.45rem 0; font-size: 0.78rem; border-bottom: 1px solid var(--border); }
.prov-step:last-child { border-bottom: none; }
.prov-num { width: 22px; height: 22px; background: var(--accent-dim); color: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700; flex-shrink: 0; }
.prov-detail { flex: 1; min-width: 0; }
.prov-tool-name { font-weight: 600; }
.prov-params { font-family: var(--mono); font-size: 0.68rem; color: var(--text-dim); word-break: break-all; margin-top: 0.15rem; }
.prov-ts { font-family: var(--mono); font-size: 0.66rem; color: var(--text-dim); white-space: nowrap; flex-shrink: 0; }

/* ===================== EVIDENCE BROWSER ===================== */
.ev-browser { display: flex; height: calc(100vh - 130px); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); }
.ev-source-tree { width: 260px; border-right: 1px solid var(--border); overflow-y: auto; flex-shrink: 0; background: var(--bg2); }
.ev-tree-group { border-bottom: 1px solid var(--border); }
.ev-tree-group-header { padding: 0.6rem 1rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: background 0.15s; }
.ev-tree-group-header:hover { background: var(--hover-tint); }
.ev-tree-group-header .chev { font-size: 0.5rem; transition: transform 0.2s; }
.ev-tree-group.collapsed .ev-tree-items { display: none; }
.ev-tree-group.collapsed .chev { transform: rotate(-90deg); }
.ev-tree-item { padding: 0.45rem 1rem 0.45rem 1.75rem; font-size: 0.78rem; cursor: pointer; color: var(--text-muted); transition: all 0.15s; border-left: 2px solid transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ev-tree-item:hover { color: var(--text); background: var(--hover-tint); }
.ev-tree-item.active { color: var(--accent); background: var(--accent-dim); border-left-color: var(--accent); }
.ev-tree-item .line-count { font-family: var(--mono); font-size: 0.62rem; color: var(--text-dim); margin-left: 0.3rem; }
.ev-viewer { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.ev-viewer-header { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
.ev-viewer-header .ev-source-title { font-weight: 700; font-size: 0.9rem; }
.ev-viewer-header .ev-source-meta { font-size: 0.72rem; color: var(--text-dim); font-family: var(--mono); }
.ev-viewer-search { padding: 0.5rem 1rem; border-bottom: 1px solid var(--border); flex-shrink: 0; }
.ev-viewer-search input { width: 100%; padding: 0.4rem 0.75rem; background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-family: var(--mono); font-size: 0.8rem; outline: none; }
.ev-viewer-search input:focus { border-color: var(--accent); }
.ev-viewer-body { flex: 1; overflow-y: auto; font-family: var(--mono); font-size: 0.78rem; line-height: 1.6; background: var(--code-bg); }
.ev-line { display: flex; padding: 0 1rem; min-height: 1.6em; }
.ev-line:hover { background: var(--hover-tint); }
.ev-line.highlight { background: rgba(217,184,64,0.15); }
.ev-line-num { width: 50px; flex-shrink: 0; text-align: right; color: var(--text-dim); padding-right: 1rem; user-select: none; opacity: 0.5; }
.ev-line-text { white-space: pre-wrap; word-break: break-all; flex: 1; }
.ev-empty { padding: 3rem; text-align: center; color: var(--text-dim); font-size: 0.9rem; }
.ev-truncated { padding: 0.6rem 1rem; background: var(--medium-dim); color: var(--medium); font-size: 0.75rem; text-align: center; border-top: 1px solid var(--border); }

/* ===================== IOC PAGE ===================== */
.ioc-copy-btn { background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 0.75rem; padding: 0.15em 0.3em; transition: color 0.15s; }
.ioc-copy-btn:hover { color: var(--accent); }
.ioc-lookup { font-size: 0.68rem; color: var(--accent); text-decoration: none; margin-left: 0.3rem; opacity: 0.7; transition: opacity 0.15s; }
.ioc-lookup:hover { opacity: 1; }

/* ===================== ATT&CK PAGE ===================== */
.tactic-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.5rem 0; margin-bottom: 1.5rem; }
.tactic-pill { padding: 0.4rem 0.75rem; border-radius: 20px; font-size: 0.72rem; font-weight: 600; border: 1px solid var(--border); color: var(--text-dim); background: var(--surface); transition: all 0.2s; }
.tactic-pill.active { background: var(--info-dim); color: var(--info); border-color: var(--info-border); cursor: pointer; }
.tactic-pill.active:hover { border-color: var(--info); box-shadow: 0 0 8px var(--info-dim); }
.tactic-pill .tactic-badge { display: inline-block; background: var(--info); color: #fff; font-size: 0.58rem; font-weight: 700; border-radius: 9px; padding: 0.05em 0.45em; margin-left: 0.35em; vertical-align: middle; line-height: 1.4; }

.tactic-accordion { display: flex; flex-direction: column; gap: 0.75rem; }
.tactic-section { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
.tactic-section-header { padding: 0.75rem 1rem; background: var(--surface); display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: background 0.2s; }
.tactic-section-header:hover { background: var(--info-dim); }
.tactic-section-header.open { background: var(--info-dim); border-bottom: 1px solid var(--info-border); }
.tactic-section-name { font-size: 0.88rem; font-weight: 700; color: var(--info); }
.tactic-section-meta { font-size: 0.72rem; color: var(--text-muted); font-family: var(--mono); }
.tactic-section-body { display: none; padding: 0.75rem 1rem; }
.tactic-section.open .tactic-section-body { display: block; }
.tactic-section-body .technique-row { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
.tactic-section-body .technique-row:last-child { border-bottom: none; }
.technique-id { font-family: var(--mono); font-size: 0.78rem; font-weight: 700; color: var(--info); min-width: 80px; flex-shrink: 0; }
.technique-id a { color: inherit; text-decoration: none; }
.technique-id a:hover { text-decoration: underline; }
.technique-info { flex: 1; min-width: 0; }
.technique-name { font-size: 0.82rem; font-weight: 600; color: var(--text); }
.technique-findings { margin-top: 0.3rem; display: flex; flex-direction: column; gap: 0.15rem; }
.technique-finding-link { font-size: 0.72rem; color: var(--text-muted); cursor: pointer; transition: color 0.15s; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.technique-finding-link:hover { color: var(--accent); }
.technique-count { font-size: 0.68rem; color: var(--text-dim); flex-shrink: 0; font-family: var(--mono); }

.tactic-ministrip { display: flex; gap: 2px; flex-wrap: wrap; padding: 0.4rem 0; }
.tactic-minicell { width: 18px; height: 18px; border-radius: 3px; border: 1px solid var(--border); background: var(--surface); position: relative; }
.tactic-minicell.active { background: var(--info-dim); border-color: var(--info-border); }
.tactic-minicell .mini-tooltip { display: none; position: absolute; bottom: calc(100% + 4px); left: 50%; transform: translateX(-50%); background: var(--bg2); border: 1px solid var(--border); border-radius: 5px; padding: 0.25rem 0.5rem; font-size: 0.62rem; white-space: nowrap; z-index: 10; pointer-events: none; color: var(--text-muted); box-shadow: var(--shadow); }
.tactic-minicell:hover .mini-tooltip { display: block; }
.tactic-minicell.active .mini-tooltip { color: var(--info); }

/* ===================== EVIDENCE DRAWER ===================== */
.evidence-drawer-overlay { display: none; position: fixed; inset: 0; background: var(--overlay-light); backdrop-filter: blur(4px); z-index: 300; }
.evidence-drawer-overlay.open { display: block; }
.evidence-drawer { position: fixed; top: 0; right: -480px; bottom: 0; width: 480px; max-width: 90vw; background: var(--bg2); border-left: 1px solid var(--border); z-index: 310; overflow-y: auto; transition: right var(--transition-slow); box-shadow: -8px 0 32px rgba(0,0,0,0.4); }
.evidence-drawer.open { right: 0; }
.drawer-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: var(--bg2); z-index: 1; }
.drawer-header h3 { font-size: 1rem; font-weight: 700; }
.drawer-close { width: 32px; height: 32px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); color: var(--text-muted); cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
.drawer-close:hover { border-color: var(--accent); color: var(--accent); }
.drawer-body { padding: 1.5rem; }
.drawer-section { margin-bottom: 1.5rem; }
.drawer-section-title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); font-weight: 600; margin-bottom: 0.6rem; }
.drawer-json { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; font-family: var(--mono); font-size: 0.72rem; overflow-x: auto; white-space: pre-wrap; line-height: 1.6; color: var(--text-muted); }
.drawer-json .json-key { color: var(--accent); }
.drawer-json .json-str { color: var(--low); }
.drawer-json .json-num { color: var(--high); }
.drawer-finding-link { display: block; padding: 0.5rem 0.75rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 0.35rem; font-size: 0.8rem; cursor: pointer; transition: all 0.15s; text-decoration: none; color: var(--text); }
.drawer-finding-link:hover { border-color: var(--accent); }

/* ===================== COMMAND PALETTE ===================== */
.cmd-overlay { display: none; position: fixed; inset: 0; background: var(--overlay); backdrop-filter: blur(8px); z-index: 400; justify-content: center; padding-top: 15vh; }
.cmd-overlay.open { display: flex; }
.cmd-palette { width: 560px; max-width: 92vw; max-height: 70vh; background: var(--bg2); border: 1px solid var(--border-light); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg), 0 0 40px var(--accent-dim); overflow: hidden; display: flex; flex-direction: column; }
.cmd-input-wrap { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0.75rem; }
.cmd-input-icon { color: var(--accent); font-size: 1.1rem; flex-shrink: 0; }
.cmd-input { flex: 1; background: none; border: none; color: var(--text); font-family: var(--font); font-size: 1rem; outline: none; }
.cmd-input::placeholder { color: var(--text-dim); }
.cmd-results { overflow-y: auto; flex: 1; padding: 0.5rem; }
.cmd-result-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.55rem 0.85rem; border-radius: 8px; cursor: pointer; transition: background 0.1s; font-size: 0.85rem; }
.cmd-result-item:hover, .cmd-result-item.selected { background: var(--accent-dim); }
.cmd-result-type { font-size: 0.6rem; font-weight: 600; text-transform: uppercase; padding: 0.15em 0.45em; border-radius: 4px; letter-spacing: 0.04em; flex-shrink: 0; min-width: 52px; text-align: center; }
.cmd-result-type.t-finding { background: var(--critical-dim); color: var(--critical); }
.cmd-result-type.t-ioc { background: var(--high-dim); color: var(--high); }
.cmd-result-type.t-source { background: var(--info-dim); color: var(--info); }
.cmd-result-type.t-tool { background: var(--low-dim); color: var(--low); }
.cmd-result-type.t-page { background: var(--accent-dim); color: var(--accent); }
.cmd-result-type.t-attack { background: var(--info-dim); color: var(--info); }
.cmd-result-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cmd-result-meta { font-size: 0.7rem; color: var(--text-dim); font-family: var(--mono); flex-shrink: 0; }
.cmd-footer { padding: 0.5rem 1rem; border-top: 1px solid var(--border); font-size: 0.68rem; color: var(--text-dim); display: flex; gap: 1.5rem; }
.cmd-footer kbd { background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 0.1em 0.4em; font-family: var(--mono); font-size: 0.65rem; }

/* ===================== TOAST & BACK TO TOP ===================== */
.copy-toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; padding: 0.6rem 1.15rem; border-radius: var(--radius); font-size: 0.8rem; font-weight: 600; opacity: 0; transform: translateY(10px); transition: all 0.3s cubic-bezier(0.4,0,0.2,1); pointer-events: none; z-index: 1000; box-shadow: var(--shadow-lg); }
.copy-toast.show { opacity: 1; transform: translateY(0); }
.back-to-top { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%) translateY(60px); width: 40px; height: 40px; border-radius: 50%; background: var(--surface-solid); border: 1px solid var(--border); color: var(--text-muted); cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: all 0.3s; z-index: 50; opacity: 0; pointer-events: none; box-shadow: var(--shadow); }
.back-to-top.visible { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }
.back-to-top:hover { border-color: var(--accent); color: var(--accent); }

/* ===================== PRINT ===================== */
@media print {
  .sidebar, .mobile-toggle, .sidebar-overlay, .search-wrap, .filter-bar, .tabs,
  .cmd-overlay, .evidence-drawer, .evidence-drawer-overlay, .tl-controls,
  .findings-toolbar-actions, .btn-sm, .back-to-top, .theme-toggle, .tl-minimap { display: none !important; }
  .main { margin-left: 0 !important; }
  .page { display: block !important; padding: 1rem 0; break-inside: avoid; opacity: 1 !important; transform: none !important; }
  .finding-body, .prov-body, .tab-pane, .tl-detail-panel { display: block !important; }
  body { background: #fff; color: #111; font-size: 11px; }
  .card, .stat, .finding-card, .tl-item, .prov-finding, .exec-summary, .attack-card, .tactic-col-header, .tactic-col-body, .tactic-cell, .exec-pill { border-color: #ddd; background: #fafafa !important; backdrop-filter: none; }
  .stat-value, .badge, .nav-item { color: #111 !important; -webkit-text-fill-color: #111 !important; }
  .page-header h2 { -webkit-text-fill-color: #111 !important; }
  .exec-summary::before { background: #333; }
  .ev-browser { height: auto; }
}
</style>
</head>
<body>

<button class="mobile-toggle" onclick="toggleSidebar()" aria-label="Toggle menu">&#9776;</button>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <h1><span>Mulder</span></h1>
    <div class="case-id">{{ case_id }}</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section-label">Overview</div>
    <a class="nav-item active" onclick="navigate('dashboard')" data-page="dashboard">
      <span class="nav-icon">&#9673;</span> Dashboard
    </a>
    {% if narrative_html %}<a class="nav-item" onclick="navigate('report')" data-page="report">
      <span class="nav-icon">&#9998;</span> Report
    </a>{% endif %}
    <a class="nav-item" onclick="navigate('timeline')" data-page="timeline">
      <span class="nav-icon">&#8614;</span> Timeline
      <span class="nav-badge">{{ timeline_findings | length }}</span>
    </a>
    <div class="nav-section-label">Appendices</div>
    <a class="nav-item" onclick="navigate('findings')" data-page="findings">
      <span class="nav-icon">&#9888;</span> Findings
      <span class="nav-badge">{{ finding_count }}</span>
    </a>
    <a class="nav-item" onclick="navigate('iocs')" data-page="iocs">
      <span class="nav-icon">&#9733;</span> IOCs
      <span class="nav-badge">{{ network_iocs | length + file_iocs | length + email_iocs | length }}</span>
    </a>
    {% if mitre_techniques %}<a class="nav-item" onclick="navigate('attack')" data-page="attack">
      <span class="nav-icon">&#9876;</span> ATT&amp;CK
      <span class="nav-badge">{{ mitre_techniques | length }}</span>
    </a>{% endif %}
    {% if evidence_integrity %}<a class="nav-item" onclick="navigate('integrity')" data-page="integrity">
      <span class="nav-icon">&#9745;</span> Hashes
    </a>{% endif %}
    <div class="nav-section-label">Evidence</div>
    <a class="nav-item" onclick="navigate('evidence')" data-page="evidence">
      <span class="nav-icon">&#128269;</span> Evidence Browser
    </a>
    <a class="nav-item" onclick="navigate('sources')" data-page="sources">
      <span class="nav-icon">&#9776;</span> Sources
      <span class="nav-badge">{{ sources_list | length }}</span>
    </a>
    <div class="nav-section-label">Operations</div>
    <a class="nav-item" onclick="navigate('performance')" data-page="performance">
      <span class="nav-icon">&#9881;</span> Performance
    </a>
    <a class="nav-item" onclick="navigate('audit')" data-page="audit">
      <span class="nav-icon">&#9783;</span> Audit Trail
    </a>
  </nav>
  <div class="sidebar-footer">
    Generated {{ timestamp | truncate(19, True, '') }}<br>
    <a href="https://github.com/calebevans/mulder">Mulder</a> &mdash; AI forensics via MCP<br>
    <span class="shortcut-hint">&#8984;K search</span>
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark theme" id="themeBtn">&#9790;</button>
  </div>
</aside>

<!-- MAIN CONTENT -->
<div class="main">

<!-- ==================== DASHBOARD ==================== -->
<div class="page active" id="page-dashboard">
  <div class="page-header">
    <h2>Investigation Dashboard</h2>
    <div class="subtitle">Case <span class="mono">{{ case_id }}</span> &middot; Evidence: <span class="mono">{{ evidence_root }}</span></div>
  </div>

  <div class="exec-summary">
    <div class="exec-summary-label">Executive Summary</div>
    <p>{{ executive_summary }}</p>
  </div>

  <div class="stats-grid stagger-in">
    <div class="stat"><div class="stat-value" data-count="{{ finding_count }}">0</div><div class="stat-label">Total Findings</div></div>
    <div class="stat critical"><div class="stat-value" data-count="{{ critical_count }}">0</div><div class="stat-label">Critical</div></div>
    <div class="stat high"><div class="stat-value" data-count="{{ high_count }}">0</div><div class="stat-label">High</div></div>
    <div class="stat medium"><div class="stat-value" data-count="{{ medium_count }}">0</div><div class="stat-label">Medium</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ confirmed_count }}">0</div><div class="stat-label">Confirmed</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ inference_count }}">0</div><div class="stat-label">Inference</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ sources | length }}">0</div><div class="stat-label">Sources</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ total_tool_calls }}">0</div><div class="stat-label">Tool Calls</div></div>
  </div>

  {% set total = finding_count if finding_count > 0 else 1 %}
  <div class="card mb-1">
    <div class="card-header">Severity Breakdown</div>
    <div class="card-body">
      <div class="severity-bar">
        <div class="seg-critical" style="width:{{ (critical_count / total * 100) | round(1) }}%"></div>
        <div class="seg-high" style="width:{{ (high_count / total * 100) | round(1) }}%"></div>
        <div class="seg-medium" style="width:{{ (medium_count / total * 100) | round(1) }}%"></div>
        <div class="seg-low" style="width:{{ (low_count / total * 100) | round(1) }}%"></div>
        <div class="seg-info" style="width:{{ (info_count / total * 100) | round(1) }}%"></div>
      </div>
      <div class="severity-legend">
        {% if critical_count %}<span class="leg-critical">Critical ({{ critical_count }})</span>{% endif %}
        {% if high_count %}<span class="leg-high">High ({{ high_count }})</span>{% endif %}
        {% if medium_count %}<span class="leg-medium">Medium ({{ medium_count }})</span>{% endif %}
        {% if low_count %}<span class="leg-low">Low ({{ low_count }})</span>{% endif %}
        {% if info_count %}<span class="leg-info">Info ({{ info_count }})</span>{% endif %}
      </div>
    </div>
  </div>

  <div class="card mb-1 mt-2">
    <div class="card-header">&#9745; Forensic Soundness and Evidence Integrity</div>
    <div class="card-body" style="font-size:0.88rem;line-height:1.7;color:var(--text-muted);">
      Analysis was executed via a read-only Model Context Protocol (MCP) server mapped to the SANS SIFT toolchain. The MCP architecture enforces structural evidence protection: original evidence files were mounted as read-only volumes, all tool interactions are typed functions (no shell access), and every finding is validated against the append-only audit log before acceptance.
      {% if evidence_integrity %}{{ evidence_integrity | length }} evidence files were cryptographically validated via SHA-256 hashes computed at ingestion.{% endif %}
      {{ total_tool_calls }} tool calls executed across {{ sources | length }} indexed sources with full provenance tracking.
    </div>
  </div>

  {% if critical_findings %}
  <div class="card mb-1 mt-2">
    <div class="card-header">&#9888; Critical Findings</div>
    <div class="card-body">
      <ul class="critical-list">
        {% for f in critical_findings %}
        <li onclick="navigateToFinding('{{ f.finding_id }}')">
          <strong>{{ f.title }}</strong>
          {% if f.event_time_start %}<div class="crit-time">{{ f.event_time_start }}{% if f.event_time_end %} &mdash; {{ f.event_time_end }}{% endif %}</div>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  <div class="dash-widgets">
    {% if mitre_techniques %}
    <div class="card">
      <div class="card-header">&#9876; MITRE ATT&amp;CK Coverage</div>
      <div class="card-body">
        {% if mitre_all_tactics %}
        <div class="tactic-ministrip">
          {% for tac in mitre_all_tactics %}<div class="tactic-minicell{% if tac.active %} active{% endif %}" onclick="navigate('attack')"><span class="mini-tooltip">{{ tac.name }}{% if tac.active %} ({{ tac.technique_count }}){% endif %}</span></div>{% endfor %}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-top:0.5rem;">
          {% for grp in mitre_tactic_groups %}<span class="widget-tech" onclick="navigate('attack')" style="cursor:pointer;">{{ grp.name }} <span style="opacity:0.7">({{ grp.technique_count }})</span></span>{% endfor %}
        </div>
        {% else %}
        <div class="widget-grid">
          {% for t in mitre_techniques %}<a class="widget-tech" href="{{ t.url }}" target="_blank" rel="noopener" title="{{ t.finding_count }} finding{{ 's' if t.finding_count != 1 }}">{{ t.id }}</a>{% endfor %}
        </div>
        {% endif %}
        <div class="text-dim" style="font-size:0.72rem;margin-top:0.5rem;">{{ mitre_techniques | length }} technique{{ 's' if mitre_techniques | length != 1 }} across {{ finding_count }} findings</div>
      </div>
    </div>
    {% endif %}
    <div class="card">
      <div class="card-header">&#9733; IOC Summary</div>
      <div class="card-body">
        {% set ext_ips = network_iocs | selectattr("type", "equalto", "External IP") | list %}
        {% set int_ips = network_iocs | selectattr("type", "equalto", "Internal IP") | list %}
        {% set hash_iocs = file_iocs | selectattr("type", "in", ["SHA256","SHA1","MD5"]) | list %}
        <div class="widget-ioc-row"><span class="text-muted">External IPs</span><strong>{{ ext_ips | length }}</strong></div>
        <div class="widget-ioc-row"><span class="text-muted">Internal IPs</span><strong>{{ int_ips | length }}</strong></div>
        <div class="widget-ioc-row"><span class="text-muted">File Paths</span><strong>{{ file_iocs | selectattr("type", "equalto", "Path") | list | length }}</strong></div>
        <div class="widget-ioc-row"><span class="text-muted">Hashes</span><strong>{{ hash_iocs | length }}</strong></div>
        <div class="widget-ioc-row"><span class="text-muted">Emails</span><strong>{{ email_iocs | length }}</strong></div>
      </div>
    </div>
  </div>

  <div class="card mt-2">
    <div class="card-header">Investigation Metadata</div>
    <div class="card-body">
      <table class="data-table">
        <tbody>
          <tr><td style="width:180px;color:var(--text-muted)">Case ID</td><td class="mono">{{ case_id }}</td></tr>
          <tr><td style="color:var(--text-muted)">Evidence Root</td><td class="mono">{{ evidence_root }}</td></tr>
          <tr><td style="color:var(--text-muted)">Report Generated</td><td class="mono">{{ timestamp | truncate(19, True, '') }}</td></tr>
          {% if first_timestamp %}<tr><td style="color:var(--text-muted)">Investigation Start</td><td class="mono">{{ first_timestamp | truncate(19, True, '') }}</td></tr>{% endif %}
          {% if last_timestamp %}<tr><td style="color:var(--text-muted)">Investigation End</td><td class="mono">{{ last_timestamp | truncate(19, True, '') }}</td></tr>{% endif %}
          {% if total_duration_ms %}<tr><td style="color:var(--text-muted)">Total Processing</td><td class="mono">{{ "%.1f" | format(total_duration_ms / 1000) }}s</td></tr>{% endif %}
          <tr><td style="color:var(--text-muted)">Audit Log</td><td class="mono" style="font-size:0.72rem;">{{ audit_log_path }}</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ==================== EVIDENCE HASHES ==================== -->
{% if evidence_integrity %}
<div class="page" id="page-integrity">
  <div class="page-header">
    <h2>Evidence Hashes</h2>
    <div class="subtitle">SHA-256 hashes recorded at ingestion &mdash; verify with <code>sha256sum &lt;file&gt;</code></div>
  </div>
  <div class="card" style="margin-bottom:1.5rem;">
    <div style="display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;">
      <span class="badge" style="background:var(--info-dim);color:var(--info);font-size:0.85rem;padding:0.4rem 0.8rem;">{{ evidence_integrity | length }} FILES</span>
      <span style="color:var(--text-muted)">Hashes computed during evidence ingestion. Compare against your local copies to confirm integrity.</span>
    </div>
  </div>
  <div class="card">
    <table class="data-table">
      <thead><tr><th>File</th><th>SHA-256</th><th>Size</th></tr></thead>
      <tbody>
        {% for e in evidence_integrity %}
        <tr>
          <td class="mono" style="font-size:0.75rem;">{{ e.file_path | basename }}</td>
          <td class="mono" style="font-size:0.72rem;user-select:all;">{{ e.sha256 }}</td>
          <td>{{ e.size_bytes | filesizeformat }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

<!-- ==================== NARRATIVE REPORT ==================== -->
{% if narrative_html %}
<div class="page" id="page-report">
  <div class="page-header">
    <h2>Investigation Report</h2>
    <div class="subtitle">Case <span class="mono">{{ case_id }}</span></div>
  </div>
  <div class="report-narrative">
    {{ narrative_html | safe }}
  </div>
</div>
{% endif %}

<!-- ==================== TIMELINE ==================== -->
<div class="page" id="page-timeline">
  <div class="page-header">
    <h2>Attack Timeline</h2>
    <div class="subtitle">{{ timeline_findings | length }} events ordered chronologically</div>
  </div>
  {% if timeline_findings %}
  <div id="tlMinimap" class="tl-minimap"></div>
  <div class="tl-controls">
    <div class="filter-bar" id="tlFilters" style="margin-bottom:0;">
      <button class="filter-btn active" onclick="setTlFilter('all', this)">All</button>
      <button class="filter-btn" onclick="setTlFilter('critical', this)">Critical</button>
      <button class="filter-btn" onclick="setTlFilter('high', this)">High</button>
      <button class="filter-btn" onclick="setTlFilter('medium', this)">Medium</button>
      <button class="filter-btn" onclick="setTlFilter('low', this)">Low</button>
    </div>
  </div>
  <div id="tl-list-view">
    <div class="timeline">
      {% set ns = namespace(last_day='') %}
      {% for f in timeline_findings %}
      {% set day = f.event_time_start[:10] if f.event_time_start and f.event_time_start|length >= 10 else 'Unknown' %}
      {% if day != ns.last_day %}{% set ns.last_day = day %}<div class="tl-group-label">{{ day }}</div>{% endif %}
      <div class="tl-item sev-{{ f.severity }}" data-severity="{{ f.severity }}" onclick="toggleTimelineDetail('tld_{{ f.finding_id }}')">
        <div class="tl-time">{{ f.event_time_start }}{% if f.event_time_end %} &mdash; {{ f.event_time_end }}{% endif %}</div>
        <div class="tl-title">{{ f.title }}</div>
        <div class="tl-badges">
          <span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>
          <span class="badge badge-{{ f.confidence }}">{{ f.confidence }}</span>
        </div>
        <div class="tl-sources">{{ f.sources | join(', ') }}</div>
      </div>
      <div class="tl-detail-panel" id="tld_{{ f.finding_id }}">
        {{ f.description_html | safe }}
        <div style="margin-top:0.75rem;">
          <a style="color:var(--accent);cursor:pointer;font-size:0.8rem;" onclick="event.stopPropagation();navigateToFinding('{{ f.finding_id }}')">View full finding &rarr;</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <p class="text-muted">No timeline events available.</p>
  {% endif %}
</div>

<!-- ==================== FINDINGS ==================== -->
<div class="page" id="page-findings">
  <div class="page-header">
    <h2>Findings</h2>
    <div class="subtitle">{{ finding_count }} findings across {{ sources | length }} evidence sources</div>
  </div>
  <div class="search-wrap">
    <input type="text" class="search-input" id="findingSearch" placeholder="Search findings..." oninput="filterFindings()">
  </div>
  <div class="findings-toolbar">
    <div class="filter-bar" id="findingFilters">
      <button class="filter-btn active" onclick="setFindingFilter('all', this)">All ({{ finding_count }})</button>
      {% if critical_count %}<button class="filter-btn" onclick="setFindingFilter('critical', this)">Critical ({{ critical_count }})</button>{% endif %}
      {% if high_count %}<button class="filter-btn" onclick="setFindingFilter('high', this)">High ({{ high_count }})</button>{% endif %}
      {% if medium_count %}<button class="filter-btn" onclick="setFindingFilter('medium', this)">Medium ({{ medium_count }})</button>{% endif %}
      {% if low_count %}<button class="filter-btn" onclick="setFindingFilter('low', this)">Low ({{ low_count }})</button>{% endif %}
      {% if confirmed_count %}<button class="filter-btn" onclick="setFindingFilter('confirmed', this)">Confirmed ({{ confirmed_count }})</button>{% endif %}
      {% if inference_count %}<button class="filter-btn" onclick="setFindingFilter('inference', this)">Inference ({{ inference_count }})</button>{% endif %}
    </div>
    <div class="findings-toolbar-actions">
      <button class="btn-sm" onclick="toggleAllFindings(true)">Expand All</button>
      <button class="btn-sm" onclick="toggleAllFindings(false)">Collapse All</button>
    </div>
  </div>
  <div id="findingsList">
  {% for f in findings %}
  <div class="finding-card" id="{{ f.finding_id }}" data-severity="{{ f.severity }}" data-confidence="{{ f.confidence }}" data-sources="{{ f.sources | join(',') }}">
    <div class="finding-header" onclick="toggleFinding(this)">
      <span class="finding-chevron">&#9654;</span>
      <span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>
      <span class="badge badge-{{ f.confidence }}">{{ f.confidence }}</span>
      <span class="finding-name">{{ f.title }}</span>
    </div>
    <div class="finding-body">
      <div class="finding-desc">{{ f.description_html | safe }}</div>
      <div class="evidence-strength">
        <span>Evidence strength:</span>
        <div class="evidence-strength-bar"><div class="evidence-strength-fill" style="width:{{ [f.evidence_refs | length * 20, 100] | min }}%"></div></div>
        <span>{{ f.evidence_refs | length }} ref{{ 's' if f.evidence_refs | length != 1 }}</span>
      </div>
      {% if related_titles.get(f.finding_id) %}
      <div class="finding-related">
        <span style="font-size:0.7rem;color:var(--text-dim);margin-right:0.3rem;">Related:</span>
        {% for rt in related_titles[f.finding_id] %}
        <a class="finding-related-link" onclick="navigateToFinding('{{ rt.finding_id }}')">{{ rt.title | truncate(50) }}</a>
        {% endfor %}
      </div>
      {% endif %}
      <div class="finding-source-pills">
        {% for src in f.sources %}<span class="source-pill" onclick="navigateToEvidence('{{ src }}')">{{ src | truncate(40) }}</span>{% endfor %}
      </div>
      {% if f.mitre_attack_ids %}
      <div class="finding-source-pills">
        {% for tid in f.mitre_attack_ids %}<a class="attack-pill" href="{{ tid | attack_url }}" target="_blank" rel="noopener">{{ tid }}</a>{% endfor %}
      </div>
      {% endif %}
      {% for pc in provenance_chains %}{% if pc.finding_id == f.finding_id and pc.evidence | length > 0 %}
      <div class="evidence-chain">
        <h4>Evidence Chain</h4>
        {% for ev in pc.evidence %}
        <div class="ev-item" onclick="openDrawer('{{ ev.tool_call_id }}')">
          <span class="ev-id">{{ ev.tool_call_id }}</span>
          <span class="ev-tool">{{ ev.tool_name }}</span>
          <span class="ev-duration">{{ "%.0f" | format(ev.duration_ms) }}ms</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}{% endfor %}
      <div class="finding-meta-bar">
        {% if f.event_time_start %}<div><strong>Time:</strong> {{ f.event_time_start }}{% if f.event_time_end %} &mdash; {{ f.event_time_end }}{% endif %}</div>{% endif %}
        <div><strong>Sources:</strong> {{ f.sources | join(', ') }}</div>
        <div><strong>Evidence Refs:</strong> {{ f.evidence_refs | join(', ') }}</div>
        {% if f.mitre_attack_ids %}<div><strong>ATT&amp;CK:</strong> {% for tid in f.mitre_attack_ids %}<a href="{{ tid | attack_url }}" target="_blank" rel="noopener" style="color:var(--info)">{{ tid }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  </div>
  {% if negative_findings %}
  <div class="card mt-2">
    <div class="card-header">&#10003; Ruled Out (Negative Findings)</div>
    <div class="card-body">
      <p style="opacity:0.7;margin-bottom:1em;">These hypotheses were explicitly tested and no supporting evidence was found.</p>
      <ul style="list-style:none;padding:0;">
        {% for nf in negative_findings %}
        <li style="padding:0.5em 0;border-bottom:1px solid var(--border);cursor:pointer;" onclick="var d=this.querySelector('.neg-full');if(d){d.style.display=d.style.display==='none'?'block':'none'}">
          <strong>{{ nf.title | replace("[NEGATIVE] ", "") }}</strong>
          <div style="opacity:0.6;font-size:0.75em;margin-top:0.15em;">Click to expand</div>
          <div class="neg-full" style="display:none;opacity:0.85;font-size:0.88em;margin-top:0.5em;line-height:1.6;">{{ nf.description_html if nf.description_html is defined else nf.description }}</div>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}
</div>

<!-- ==================== ATT&CK ==================== -->
{% if mitre_techniques %}
<div class="page" id="page-attack">
  <div class="page-header">
    <h2>MITRE ATT&amp;CK Coverage</h2>
    <div class="subtitle">{{ mitre_techniques | length }} technique{{ 's' if mitre_techniques | length != 1 }} identified across findings</div>
  </div>
  <div class="stats-grid stagger-in" style="margin-bottom:1.5rem;">
    <div class="stat"><div class="stat-value" data-count="{{ mitre_techniques | length }}">0</div><div class="stat-label">Techniques</div></div>
    {% if mitre_tactic_groups %}<div class="stat"><div class="stat-value" data-count="{{ mitre_tactic_groups | length }}">0</div><div class="stat-label">Tactics</div></div>{% endif %}
    <div class="stat"><div class="stat-value" data-count="{{ finding_count }}">0</div><div class="stat-label">Findings Mapped</div></div>
  </div>
  {% if mitre_all_tactics %}
  <div class="tactic-grid">
    {% for tac in mitre_all_tactics %}<div class="tactic-pill{% if tac.active %} active{% endif %}"{% if tac.active %} onclick="toggleTacticSection('tactic-section-{{ tac.id }}')"{% endif %}>{{ tac.name }}{% if tac.active %}<span class="tactic-badge">{{ tac.technique_count }}</span>{% endif %}</div>{% endfor %}
  </div>
  <div class="tactic-accordion">
    {% for grp in mitre_tactic_groups %}
    <div class="tactic-section" id="tactic-section-{{ grp.id }}">
      <div class="tactic-section-header" onclick="this.classList.toggle('open');this.parentElement.classList.toggle('open')">
        <div class="tactic-section-name">{{ grp.name }}</div>
        <div class="tactic-section-meta">{{ grp.technique_count }} techniques / {{ grp.finding_count }} findings</div>
      </div>
      <div class="tactic-section-body">
        {% for t in grp.techniques %}
        <div class="technique-row">
          <div class="technique-id"><a href="{{ t.url }}" target="_blank" rel="noopener">{{ t.id }}</a></div>
          <div class="technique-info">
            {% if t.name %}<div class="technique-name">{{ t.name }}</div>{% endif %}
            <div class="technique-findings">
              {% for af in t.findings %}
              <div class="technique-finding-link" onclick="navigateToFinding('{{ af.finding_id }}')">{{ af.title | truncate(80) }}</div>
              {% endfor %}
            </div>
          </div>
          <div class="technique-count">{{ t.finding_count }}F</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="tactic-accordion">
    <div class="tactic-section open">
      <div class="tactic-section-header open">
        <div class="tactic-section-name">All Techniques</div>
        <div class="tactic-section-meta">{{ mitre_techniques | length }} techniques</div>
      </div>
      <div class="tactic-section-body">
        {% for t in mitre_techniques %}
        <div class="technique-row">
          <div class="technique-id"><a href="{{ t.url }}" target="_blank" rel="noopener">{{ t.id }}</a></div>
          <div class="technique-info">
            {% if t.name %}<div class="technique-name">{{ t.name }}</div>{% endif %}
            <div class="technique-findings">
              {% for af in t.findings %}
              <div class="technique-finding-link" onclick="navigateToFinding('{{ af.finding_id }}')">{{ af.title | truncate(80) }}</div>
              {% endfor %}
            </div>
          </div>
          <div class="technique-count">{{ t.finding_count }}F</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}
</div>
{% endif %}

<!-- ==================== IOCs ==================== -->
<div class="page" id="page-iocs">
  <div class="page-header">
    <h2>Indicators of Compromise</h2>
    <div class="subtitle">Extracted from finding descriptions</div>
  </div>
  {% set total_iocs = network_iocs | length + file_iocs | length + email_iocs | length %}
  {% set ext_ips = network_iocs | selectattr("type", "equalto", "External IP") | list %}
  <div class="stats-grid stagger-in">
    <div class="stat"><div class="stat-value" data-count="{{ total_iocs }}">0</div><div class="stat-label">Total IOCs</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ ext_ips | length }}">0</div><div class="stat-label">External IPs</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ file_iocs | length }}">0</div><div class="stat-label">File IOCs</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ email_iocs | length }}">0</div><div class="stat-label">Emails</div></div>
  </div>

  <div class="search-wrap">
    <input type="text" class="search-input" id="iocSearch" placeholder="Search IOCs..." oninput="filterIocTables()">
  </div>

  {% if network_iocs %}
  <div class="card mb-2">
    <div class="card-header">Network IOCs ({{ network_iocs | length }})</div>
    <table class="data-table" id="networkIocTable">
      <thead><tr><th>Type</th><th>Value</th><th>Enrichment</th><th>Context</th><th>Actions</th></tr></thead>
      <tbody>
      {% for ioc in network_iocs %}
      <tr>
        <td><span class="badge badge-{{ 'critical' if ioc.type == 'External IP' else 'info' }}">{{ ioc.type }}</span></td>
        <td><code>{{ ioc.value }}</code></td>
        <td class="text-muted" style="font-size:0.75rem;">{{ ioc.enrichment | default('') }}</td>
        <td class="text-muted" style="font-size:0.78rem;">{{ ioc.context }}</td>
        <td>
          <button class="ioc-copy-btn" onclick="copyText('{{ ioc.value }}')" title="Copy">&#128203;</button>
          {% if 'IP' in ioc.type %}<a class="ioc-lookup" href="https://www.virustotal.com/gui/ip-address/{{ ioc.value }}" target="_blank" rel="noopener" title="VirusTotal">VT</a>{% endif %}
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if file_iocs %}
  <div class="card mb-2">
    <div class="card-header">File IOCs ({{ file_iocs | length }})</div>
    <table class="data-table" id="fileIocTable">
      <thead><tr><th>Type</th><th>Value</th><th>Enrichment</th><th>Context</th><th>Actions</th></tr></thead>
      <tbody>
      {% for ioc in file_iocs %}
      <tr>
        <td><span class="badge badge-{{ 'high' if ioc.type in ['SHA256','SHA1','MD5'] else 'medium' }}">{{ ioc.type }}</span></td>
        <td><code style="font-size:0.68rem;">{{ ioc.value | truncate(60) }}</code></td>
        <td class="text-muted" style="font-size:0.75rem;">{{ ioc.enrichment | default('') }}</td>
        <td class="text-muted" style="font-size:0.78rem;">{{ ioc.context }}</td>
        <td>
          <button class="ioc-copy-btn" onclick="copyText('{{ ioc.value }}')" title="Copy">&#128203;</button>
          {% if ioc.type in ['SHA256','SHA1','MD5'] %}<a class="ioc-lookup" href="https://www.virustotal.com/gui/search/{{ ioc.value }}" target="_blank" rel="noopener" title="VirusTotal">VT</a>{% endif %}
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if email_iocs %}
  <div class="card mb-2">
    <div class="card-header">Email IOCs ({{ email_iocs | length }})</div>
    <table class="data-table" id="emailIocTable">
      <thead><tr><th>Type</th><th>Value</th><th>Enrichment</th><th>Context</th><th>Actions</th></tr></thead>
      <tbody>
      {% for ioc in email_iocs %}
      <tr>
        <td><span class="badge badge-info">{{ ioc.type }}</span></td>
        <td><code>{{ ioc.value }}</code></td>
        <td class="text-muted" style="font-size:0.75rem;">{{ ioc.enrichment | default('') }}</td>
        <td class="text-muted" style="font-size:0.78rem;">{{ ioc.context }}</td>
        <td><button class="ioc-copy-btn" onclick="copyText('{{ ioc.value }}')" title="Copy">&#128203;</button></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if not network_iocs and not file_iocs and not email_iocs %}
  <p class="text-muted">No IOCs extracted from findings.</p>
  {% endif %}
</div>

<!-- ==================== EVIDENCE BROWSER ==================== -->
<div class="page" id="page-evidence">
  <div class="page-header">
    <h2>Evidence Browser</h2>
    <div class="subtitle">Browse raw extracted evidence analyzed during the investigation</div>
  </div>
  <div class="ev-browser" id="evBrowser">
    <div class="ev-source-tree" id="evSourceTree"></div>
    <div class="ev-viewer">
      <div class="ev-viewer-header">
        <span class="ev-source-title" id="evTitle">Select a source</span>
        <span class="ev-source-meta" id="evMeta"></span>
      </div>
      <div class="ev-viewer-search">
