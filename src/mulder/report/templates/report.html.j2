function syntaxHighlight(json) { return json.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"([^"]+)":/g,'<span class="json-key">"$1"</span>:').replace(/: "([^"]*)"/g,': <span class="json-str">"$1"</span>').replace(/: (\d+\.?\d*)/g,': <span class="json-num">$1</span>'); }

/* ========== EVIDENCE BROWSER ========== */
var evTreeBuilt = false;
var currentEvSource = null;
function buildEvSourceTree() {
  if (evTreeBuilt) return;
  var tree = document.getElementById('evSourceTree');
  var groups = {};
  Object.keys(SOURCE_WINDOWS).forEach(function(name) {
    var parts = name.split('.');
    var group = parts[0] || 'other';
    if (!groups[group]) groups[group] = [];
    groups[group].push(name);
  });
  var html = '';
  Object.keys(groups).sort().forEach(function(g) {
    html += '<div class="ev-tree-group"><div class="ev-tree-group-header" onclick="this.parentElement.classList.toggle(\'collapsed\')"><span class="chev">&#9660;</span> ' + g.charAt(0).toUpperCase()+g.slice(1) + ' <span style="opacity:0.5;font-size:0.6rem;">(' + groups[g].length + ')</span></div><div class="ev-tree-items">';
    groups[g].sort().forEach(function(name) {
      var meta = SOURCES_META[name] || {};
      html += '<div class="ev-tree-item" data-source="'+name+'" onclick="selectEvSource(\''+name+'\')">'+name+'<span class="line-count">'+(meta.line_count||'')+'</span></div>';
    });
    html += '</div></div>';
  });
  if (!html) html = '<div class="ev-empty">No evidence data embedded in this report.</div>';
  tree.innerHTML = html;
  evTreeBuilt = true;
}
function selectEvSource(name) {
  buildEvSourceTree();
  currentEvSource = name;
  document.querySelectorAll('.ev-tree-item').forEach(function(i) { i.classList.toggle('active', i.dataset.source === name); });
  var activeItem = document.querySelector('.ev-tree-item[data-source="'+name+'"]');
  if (activeItem) {
    var group = activeItem.closest('.ev-tree-group');
    if (group) group.classList.remove('collapsed');
    activeItem.scrollIntoView({block:'nearest'});
  }
  document.getElementById('evTitle').textContent = name;
  var meta = SOURCES_META[name] || {};
  document.getElementById('evMeta').textContent = (meta.extractor||'')+' \u2022 '+(meta.line_count||0)+' lines';
  var windows = SOURCE_WINDOWS[name] || [];
  var body = document.getElementById('evViewerBody');
  if (!windows.length) { body.innerHTML = '<div class="ev-empty">No evidence data available for this source.</div>'; return; }
  var html = '';
  var lineNum = 0;
  windows.forEach(function(w) {
    var lines = w.raw_text.split('\n');
    lines.forEach(function(line) {
      lineNum++;
      var escaped = line.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      html += '<div class="ev-line" data-ln="'+lineNum+'"><span class="ev-line-num">'+lineNum+'</span><span class="ev-line-text">'+escaped+'</span></div>';
    });
  });
  if (windows.length > 0 && windows[0].truncated) {
    html += '<div class="ev-truncated">Showing first 500 windows of '+windows[0].total+' total. Full data available in the case database.</div>';
  }
  body.innerHTML = html;
  body.scrollTop = 0;
  document.getElementById('evSearchInput').value = '';
  window.location.hash = '#/evidence/' + encodeURIComponent(name);
}
function evSearchHighlight() {
  var q = document.getElementById('evSearchInput').value.toLowerCase();
  document.querySelectorAll('#evViewerBody .ev-line').forEach(function(line) {
    line.classList.toggle('highlight', q.length > 1 && line.textContent.toLowerCase().indexOf(q) !== -1);
  });
}

