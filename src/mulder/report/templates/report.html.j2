/* ========== SPA ROUTER ========== */
function navigate(page, skipHash) {
  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
  document.querySelectorAll('.nav-item').forEach(function(n) { n.classList.remove('active'); });
  var el = document.getElementById('page-' + page);
  if (el) el.classList.add('active');
  var nav = document.querySelector('[data-page="' + page + '"]');
  if (nav) nav.classList.add('active');
  if (!skipHash) window.location.hash = '#/' + page;
  closeSidebar();
  if (page === 'dashboard' || page === 'performance' || page === 'iocs' || page === 'attack') animateCounters();
  if (page === 'performance') { renderDonut(); renderSparkline(); }
  if (page === 'evidence') buildEvSourceTree();
  if (page === 'timeline') renderMinimap();
}

function scrollToTactic(elementId) {
  var el = document.getElementById(elementId);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
}
function toggleTacticSection(sectionId) {
  var section = document.getElementById(sectionId);
  if (!section) return;
  var header = section.querySelector('.tactic-section-header');
  section.classList.toggle('open');
  if (header) header.classList.toggle('open');
  section.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function navigateToFinding(findingId) {
  navigate('findings');
  setTimeout(function() {
    var el = document.getElementById(findingId);
    if (el) {
      el.classList.add('open');
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      el.style.boxShadow = '0 0 0 2px var(--accent), 0 0 20px rgba(96,165,250,0.2)';
      setTimeout(function() { el.style.boxShadow = ''; }, 2500);
    }
  }, 120);
}

function navigateToEvidence(sourceName) {
  navigate('evidence');
  setTimeout(function() { selectEvSource(sourceName); }, 150);
}

function handleHash() {
  var hash = window.location.hash;
  if (hash.startsWith('#/findings/')) navigateToFinding(hash.replace('#/findings/', ''));
  else if (hash.startsWith('#/evidence/')) { navigate('evidence', true); setTimeout(function(){ selectEvSource(decodeURIComponent(hash.replace('#/evidence/','')));},150); }
  else if (hash.startsWith('#/')) { var page = hash.replace('#/', ''); if (document.getElementById('page-' + page)) navigate(page, true); }
}
window.addEventListener('hashchange', handleHash);
window.addEventListener('load', function() { if (window.location.hash) handleHash(); else animateCounters(); });

/* ========== COUNTERS ========== */
function animateCounters() {
  document.querySelectorAll('.page.active .stat-value[data-count]').forEach(function(el) {
    var target = parseInt(el.dataset.count, 10);
    if (isNaN(target)) return;
    var dur = 600, startTime = null;
    function step(ts) {
      if (!startTime) startTime = ts;
      var p = Math.min((ts - startTime) / dur, 1);
      p = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(target * p);
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  });
}

