    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="text-muted">No source metadata available.</p>
  {% endif %}
</div>

<!-- ==================== PERFORMANCE ==================== -->
<div class="page" id="page-performance">
  <div class="page-header">
    <h2>Investigation Performance</h2>
    <div class="subtitle">Tool usage, processing time, and token estimates</div>
  </div>
  <div class="stats-grid stagger-in">
    <div class="stat"><div class="stat-value" data-count="{{ total_tool_calls }}">0</div><div class="stat-label">Tool Calls</div></div>
    <div class="stat"><div class="stat-value" data-count="{{ tool_call_counts | length }}">0</div><div class="stat-label">Unique Tools</div></div>
    <div class="stat"><div class="stat-value">{{ "%.1f" | format(total_duration_ms / 1000) if total_duration_ms else '0' }}s</div><div class="stat-label">Processing Time</div></div>
    {% if model_token_breakdown %}{% set _total_tok = model_token_breakdown | sum(attribute='input') + model_token_breakdown | sum(attribute='output') %}<div class="stat"><div class="stat-value">{{ "{:,.0f}".format(_total_tok) }}</div><div class="stat-label">Tokens</div></div>
    {% if total_duration_ms > 0 %}<div class="stat"><div class="stat-value">{{ "{:,.0f}".format(_total_tok / (total_duration_ms / 60000)) }}</div><div class="stat-label">Tokens/min</div></div>{% endif %}
    {% else %}<div class="stat"><div class="stat-value">~{{ "%.0f" | format((estimated_input_tokens + estimated_output_tokens) / 1000) }}k</div><div class="stat-label">Est. Tokens</div></div>{% endif %}
  </div>
  <div class="perf-grid">
    <div class="card">
      <div class="card-header">Tool Distribution</div>
      <div class="card-body"><div class="donut-container"><svg id="donutChart" width="160" height="160" viewBox="0 0 160 160"></svg><div class="donut-legend" id="donutLegend"></div></div></div>
    </div>
    <div class="card">
      <div class="card-header">Token Breakdown</div>
      <div class="card-body">
        <table class="data-table" style="font-size:0.8rem;">
          <tbody>
            {% if model_token_breakdown %}
            {% set real_in = model_token_breakdown | sum(attribute='input') %}
            {% set real_out = model_token_breakdown | sum(attribute='output') %}
            <tr><td style="color:var(--text-muted)">Input Tokens</td><td class="mono" style="text-align:right;">{{ "{:,}".format(real_in) }}</td></tr>
            <tr><td style="color:var(--text-muted)">Output Tokens</td><td class="mono" style="text-align:right;">{{ "{:,}".format(real_out) }}</td></tr>
            <tr><td style="color:var(--text-muted)">Total Tokens</td><td class="mono" style="text-align:right;font-weight:700;">{{ "{:,}".format(real_in + real_out) }}</td></tr>
            <tr><td colspan="2" style="border-top:1px solid var(--border);padding-top:0.5rem;font-weight:600;">Per-Model Breakdown</td></tr>
            {% for entry in model_token_breakdown %}
            <tr><td style="color:var(--text-muted);padding-left:1rem;">{{ entry.model }}</td><td class="mono" style="text-align:right;">{{ "{:,}".format(entry.input + entry.output) }}</td></tr>
            {% endfor %}
            {% else %}
            <tr><td style="color:var(--text-muted)">Input Tokens (est.)</td><td class="mono" style="text-align:right;">{{ "{:,}".format(estimated_input_tokens) }}</td></tr>
            <tr><td style="color:var(--text-muted)">Output Tokens (est.)</td><td class="mono" style="text-align:right;">{{ "{:,}".format(estimated_output_tokens) }}</td></tr>
            <tr><td style="color:var(--text-muted)">Total Tokens (est.)</td><td class="mono" style="text-align:right;font-weight:700;">{{ "{:,}".format(estimated_input_tokens + estimated_output_tokens) }}</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% if model_token_breakdown and model_token_breakdown | length > 1 %}
  <div class="card mb-2">
    <div class="card-header">Model Usage Comparison</div>
    <div class="card-body">
      {% set max_model_tok = [] %}
      {% for entry in model_token_breakdown %}{% if (entry.input + entry.output) > (max_model_tok | last | default(0)) %}{% if max_model_tok.append(entry.input + entry.output) %}{% endif %}{% endif %}{% endfor %}
      {% set max_tok = max_model_tok | last | default(1) %}
      <table class="data-table" style="font-size:0.8rem;width:100%;">
        <thead><tr><th>Model</th><th style="text-align:right;">Input</th><th style="text-align:right;">Output</th><th style="text-align:right;">Total</th><th style="width:40%;">Share</th></tr></thead>
        <tbody>
        {% for entry in model_token_breakdown %}
        {% set mtotal = entry.input + entry.output %}
        {% set pct = (mtotal * 100 / (_total_tok if _total_tok is defined and _total_tok > 0 else 1)) | int %}
        <tr>
          <td><strong>{{ entry.model }}</strong></td>
          <td class="mono" style="text-align:right;">{{ "{:,}".format(entry.input) }}</td>
          <td class="mono" style="text-align:right;">{{ "{:,}".format(entry.output) }}</td>
          <td class="mono" style="text-align:right;font-weight:700;">{{ "{:,}".format(mtotal) }}</td>
          <td><div style="background:var(--surface);border-radius:4px;overflow:hidden;height:18px;"><div style="background:var(--info);height:100%;width:{{ pct }}%;border-radius:4px;transition:width 0.5s;"></div></div><div style="font-size:0.65rem;color:var(--text-dim);text-align:center;margin-top:2px;">{{ pct }}%</div></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}
  {% if model_token_breakdown and total_duration_ms > 0 %}
  <div class="card mb-2">
    <div class="card-header">Token Throughput Over Time</div>
    <div class="card-body">
      <div style="font-size:0.75rem;color:var(--text-dim);margin-bottom:0.75rem;">Estimated token consumption by model over time. Each bar represents a 5-minute window.</div>
      <div style="position:relative;">
        <canvas id="throughputChart" style="width:100%;height:220px;"></canvas>
        <div id="throughputTooltip" style="display:none;position:absolute;background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:0.5rem 0.75rem;font-size:0.72rem;line-height:1.5;pointer-events:none;z-index:10;box-shadow:var(--shadow);color:var(--text-muted);min-width:120px;"></div>
      </div>
    </div>
  </div>
  {% endif %}
  
</div>

<!-- ==================== AUDIT TRAIL ==================== -->
<div class="page" id="page-audit">
  <div class="page-header">
    <h2>Audit Trail</h2>
    <div class="subtitle">Complete provenance chain from evidence to findings</div>
  </div>
  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('audit', 'log', this)">Full Log</button>
    <button class="tab-btn" onclick="switchTab('audit', 'provenance', this)">Provenance Chains</button>
  </div>
  <div class="tab-pane active" id="audit-log">
    <div class="search-wrap">
      <input type="text" class="search-input" id="auditSearch" placeholder="Search audit log..." oninput="filterAuditTable()">
    </div>
    {% if audit_entries %}
    <table class="data-table" id="auditTable">
      <thead>
        <tr>
          <th onclick="sortTable('auditTable',0)">ID <span class="sort-arrow"></span></th>
          <th onclick="sortTable('auditTable',1)">Tool <span class="sort-arrow"></span></th>
          <th onclick="sortTable('auditTable',2)">Duration <span class="sort-arrow"></span></th>
          <th onclick="sortTable('auditTable',3)">Timestamp <span class="sort-arrow"></span></th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for entry in audit_entries %}
        <tr id="audit_{{ entry.tool_call_id }}">
          <td class="mono" style="font-size:0.68rem;color:var(--accent);">{{ entry.tool_call_id }}</td>
          <td><strong>{{ entry.tool_name }}</strong></td>
          <td class="mono" style="text-align:right;">{{ "%.0f" | format(entry.duration_ms) }}ms</td>
          <td class="mono" style="font-size:0.68rem;">{{ entry.timestamp[:19] if entry.timestamp else '' }}</td>
          <td><button class="btn-sm" onclick="openDrawer('{{ entry.tool_call_id }}')" style="font-size:0.68rem;">Inspect</button></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="text-muted">No audit entries available.</p>{% endif %}
  </div>
  <div class="tab-pane" id="audit-provenance">
    <p class="text-muted mb-1">Each finding traces back to the specific tool calls that produced the supporting evidence.</p>
    {% for pc in provenance_chains %}
    <div class="prov-finding" id="prov_{{ pc.finding_id }}">
      <div class="prov-header" onclick="this.parentElement.classList.toggle('open')">
        <span class="prov-chevron">&#9654;</span>
        <span>{{ pc.title }}</span>
        <span class="badge badge-info" style="margin-left:auto;">{{ pc.evidence | length }} refs</span>
      </div>
      <div class="prov-body">
        {% for ev in pc.evidence %}
        <div class="prov-step">
          <div class="prov-num">{{ loop.index }}</div>
          <div class="prov-detail">
            <div class="prov-tool-name">{{ ev.tool_name }}</div>
            {% if ev.params %}<div class="prov-params">{{ ev.params | tojson(indent=0) | truncate(120, True) }}</div>{% endif %}
          </div>
          <div class="prov-ts">
            <div>{{ ev.tool_call_id }}</div>
            <div>{{ "%.0f" | format(ev.duration_ms) }}ms</div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>

</div><!-- end main -->
</div><!-- end app -->

<!-- Evidence Drawer -->
<div class="evidence-drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="evidence-drawer" id="evidenceDrawer">
  <div class="drawer-header">
    <h3 id="drawerTitle">Tool Call Details</h3>
    <button class="drawer-close" onclick="closeDrawer()">&times;</button>
