/* Keyboard nav for findings */
var kbdFocusIdx = -1;
function getVisibleFindings() { return Array.from(document.querySelectorAll('.finding-card')).filter(function(c){return c.style.display !== 'none';}); }
function kbdMoveFinding(dir) {
  var cards = getVisibleFindings();
  if (!cards.length) return;
  if (kbdFocusIdx >= 0 && kbdFocusIdx < cards.length) cards[kbdFocusIdx].classList.remove('kbd-focus');
  kbdFocusIdx = Math.max(0, Math.min(cards.length - 1, kbdFocusIdx + dir));
  cards[kbdFocusIdx].classList.add('kbd-focus');
  cards[kbdFocusIdx].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

