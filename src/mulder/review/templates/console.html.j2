<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Mulder case review — {{ review.case.case_id }}</title>
  <link rel="stylesheet" href="/static/review.css">
</head>
<body data-event-url="{{ event_url }}">
  <header>
    <div>
      <p class="eyebrow">Mulder read-only review</p>
      <h1>{{ review.case.case_id }}</h1>
    </div>
    <div class="status" aria-live="polite">
      <span id="event-state">Connecting to durable run events…</span>
    </div>
  </header>

  <main>
    <section class="summary-grid" aria-label="Case status">
      <article><h2>Findings</h2><p>{{ review.findings.active_total }} active · {{ review.findings.withdrawn_total }} withdrawn</p></article>
      <article><h2>Audit</h2><p>{{ review.audit.integrity_status }} · {{ review.audit.entry_count }} entries</p></article>
      <article><h2>Receipt</h2><p>{{ review.receipt.status }} · {{ review.receipt.signature_status }}</p></article>
      <article><h2>Replay</h2><p>{{ review.receipt.replay_status }}</p></article>
    </section>

    <section>
      <h2>Observed phase state</h2>
      <p class="muted">These are durable observations, not completion claims.</p>
      <ol class="phase-list">
      {% for phase in review.phases %}
        <li><strong>{{ phase.name }}</strong><span>{{ phase.state }}</span></li>
      {% endfor %}
      </ol>
    </section>

    <section>
      <div class="section-heading">
        <h2>Finding proof cards</h2>
        <a href="/api/cases/{{ review.case.case_id|urlencode }}/proof-cards">JSON</a>
      </div>
      {% for card in proof_cards %}
      <article class="proof-card">
        <div class="section-heading">
          <h3>{{ card.finding.finding_id }} — {{ card.finding.title }}</h3>
          <span class="badge">{{ card.finding.severity }} / {{ card.finding.confidence }}</span>
        </div>
        {% if card.claims %}
          {% for claim in card.claims %}
          <div class="claim">
            <p><span class="badge">{{ claim.epistemic_state }}</span> {{ claim.statement }}</p>
            <dl>
              <dt>Predicate</dt><dd>{{ claim.subject }} · {{ claim.predicate }} · {{ claim.object_value }}</dd>
              <dt>Verification</dt><dd>{{ claim.verifications|length }} recorded decision(s)</dd>
            </dl>
            {% if claim.anchors %}
            <ul class="anchor-list">
              {% for anchor in claim.anchors %}
              <li>
                <a href="{{ anchor_urls.get(anchor.anchor_id, '#') }}">
                  {{ anchor.source_name }} lines {{ anchor.line_start }}–{{ anchor.line_end }},
                  chars {{ anchor.char_start }}–{{ anchor.char_end }}
                </a>
                <code>{{ anchor.exact_text }}</code>
              </li>
              {% endfor %}
            </ul>
            {% else %}
            <p class="muted">No anchor is present in this bounded review page.</p>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
        <p class="muted">No atomic claims are recorded for this finding.</p>
        {% endif %}
      </article>
      {% else %}
      <p>No findings are present in this bounded review page.</p>
      {% endfor %}
    </section>

    <section>
      <h2>Durable run events</h2>
      <p class="muted">The stream resumes after its last audit-chain sequence ID.</p>
      <ol id="run-events" class="event-list" aria-live="polite"></ol>
    </section>

    <section>
      <div class="section-heading">
        <h2>Competing hypotheses and specialist review</h2>
        <a href="{{ reasoning_url }}">JSON</a>
      </div>
      <p class="muted">{{ review.reasoning.status }} · {{ review.reasoning.note }}</p>
      {% for hypothesis in review.reasoning.projection.hypotheses %}
      <article class="proof-card">
        <h3>{{ hypothesis.title }}</h3>
        <p>{{ hypothesis.statement }}</p>
        <p class="muted">Competing group: {{ hypothesis.competing_group }}</p>
        {% for discriminator in hypothesis.discriminators %}
        <div class="claim">
          <p><strong>Expected:</strong> {{ discriminator.expected_observation }}</p>
          <p><strong>Falsifier:</strong> {{ discriminator.falsifier }}</p>
          <p class="muted">Estimated check: {{ discriminator.estimated_cost.amount }} {{ discriminator.estimated_cost.unit }}</p>
          {% for result in discriminator.test_results %}
          <p><span class="badge">{{ result.outcome }}</span> {{ result.summary }}</p>
          {% endfor %}
        </div>
        {% endfor %}
      </article>
      {% else %}
      <p>No competing hypotheses are recorded.</p>
      {% endfor %}

      <h3>Contradictions</h3>
      {% for contradiction in review.contradictions.items %}
      <article class="claim">
        <p>
          {% if contradiction.material and not contradiction.resolution %}<span class="badge">unresolved material</span>{% endif %}
          {{ contradiction.description }}
        </p>
        {% if contradiction.resolution %}<p class="muted">{{ contradiction.resolution.disposition }} · {{ contradiction.resolution.rationale }}</p>{% endif %}
      </article>
      {% else %}
      <p>No contradictions are recorded.</p>
      {% endfor %}

      <h3>Independent reviewer seats</h3>
      <div class="placeholder-grid">
      {% for seat in review.reasoning.projection.review_seats %}
        <article>
          <h4>{{ seat.seat }}</h4>
          {% for verdict in seat.verdicts %}<p><span class="badge">{{ verdict.verdict }}</span> {{ verdict.rationale }}</p>{% else %}<p class="muted">No verdicts recorded.</p>{% endfor %}
        </article>
      {% endfor %}
      </div>
    </section>

    <section>
      <div class="section-heading">
        <h2>Verified-claim graph</h2>
        <a href="{{ graph_url }}">JSON</a>
      </div>
      <p class="muted">{{ review.graph.status }} · {{ review.graph.note }}</p>
      {% for result in review.graph.items %}
      <p>{{ result.edges|length }} edge(s), {{ result.nodes|length }} node(s); limit {{ result.limits.result_limit }}{% if result.limits.truncated %} (truncated){% endif %}</p>
      {% for edge in result.edges %}
      <article class="claim">
        <p>
          <a href="{{ graph_url }}?entity_id={{ edge.relation.source_entity_id|urlencode }}">{{ graph_node_labels.get(edge.relation.source_entity_id, edge.relation.source_entity_id) }}</a>
          · {{ edge.relation.predicate }} ·
          <a href="{{ graph_url }}?entity_id={{ edge.relation.target_entity_id|urlencode }}">{{ graph_node_labels.get(edge.relation.target_entity_id, edge.relation.target_entity_id) }}</a>
          <span class="badge">{{ edge.visibility }}</span>
        </p>
        <ul class="anchor-list">
        {% for anchor in edge.evidence_selector.anchors %}
          <li><a href="{{ anchor_urls.get(anchor.anchor_id, '#') }}">{{ anchor.source.source_name }} lines {{ anchor.line_start }}–{{ anchor.line_end }} · claim {{ edge.evidence_selector.claim_id }} · anchor {{ anchor.anchor_id }}</a></li>
        {% endfor %}
        </ul>
      </article>
      {% else %}
      <p>No relations are returned by this bounded graph view.</p>
      {% endfor %}
      {% endfor %}
    </section>

    <section class="placeholder-grid">
      <article><h2>Follow-ups</h2><p>{{ review.follow_ups.status }} · {{ review.follow_ups.note }}</p></article>
    </section>
  </main>
  <script src="/static/review.js" defer></script>
</body>
</html>
